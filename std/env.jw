// 標準ライブラリ std.env: 環境変数。`use std.env;` と書いて `env.get("HOME")` のように使う

/// 環境変数の値（なければ None。名前が空・`=` や NUL を含む・値が UTF-8 でないときも None）
pub fn Option<str> get(str name) { __env_get(name) }

/// いま動いている実行ファイルの絶対パス（分からなければ None）。同じフォルダに置いた仲間のプログラムを、PATH や作業フォルダを探さずに起こすときに使う
pub fn Option<str> exe_path() { __env_exe_path() }
