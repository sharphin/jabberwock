// 標準ライブラリ std.keystore（OS の鍵の保管庫）: 秘密のバイト列を OS に守らせる。`use std.keystore;` と書いて使う。今は Windows だけ（ほかの OS では Err）
//   let blob = keystore.protect(ref key)?;      // 今ログインしている利用者だけがほどける形に包む（ファイルに書いてよい）
//   let key2 = keystore.unprotect(ref blob)?;   // ほどく。別の利用者・別の PC・壊れたものは Err
// Windows は DPAPI（CryptProtectData）。包んだものは、同じ利用者でログインしていれば、その人として動くどのプログラムでもほどける
// （ファイルを持ち出す・別の利用者から読むことへの守り。同じ利用者として動く悪いプログラムへの守りではない）。

/// 今ログインしている利用者だけがほどける形に包む
pub fn Result<u8[], str> protect(ref u8[] data) { __keystore_protect(data.map((x) -> x)) }

/// protect で包んだものをほどく
pub fn Result<u8[], str> unprotect(ref u8[] blob) { __keystore_unprotect(blob.map((x) -> x)) }
