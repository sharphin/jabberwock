use std.time;
fn Result<(), str> go() {
    let a = time.from_unix_ms(0);
    print(a.iso(), a.weekday(), a.weekday_name());
    let b = time.from_unix_ms(1762756543123);
    print(b.iso(), b.date(), b.time(), b.weekday_name(), b.to_unix_ms());
    let c = time.from_unix_ms(-1);
    print(c.iso(), c.to_unix_ms());
    let d = time.parse_iso("2024-02-28")?;
    print(d.add_days(1).date(), d.add_days(2).date(), d.add_days(-59).date(), d.add_ms(3723004).iso());
    print(time.parse_iso("2026-11-10T06:35:43.5Z")?.iso(), time.parse_iso("2026-11-10 06:35:43")?.iso());
    for bad in ["2026-13-01", "2026-02-30", "2026/01/01", "2026-01-01T25:00:00", "2026-01-01T00:00:00.Z", "x"] {
        match time.parse_iso(bad) { case Ok(t) -> print("ok?", t.iso()); case Err(e) -> print(e); }
    }
    print(time.is_leap(2000), time.is_leap(1900), time.days_in_month(2024, 2));
    print(time.from_unix_ms(253402300799999).iso(), time.from_unix_ms(-62135596800000).iso());
    print(time.now().year >= 2024);
    Ok(())
}
fn main() { match go() { case Ok(u) -> {} case Err(e) -> print("err", e); } }
