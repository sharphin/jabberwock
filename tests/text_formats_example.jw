use std.csv;
use std.encoding;
fn Result<(), str> go() {
    let rows = csv.parse("name,age\r\n\"Smith, J\",42\n\"say \"\"hi\"\"\",\n\"two\nlines\",x\n,\n")?;
    print(rows.len());
    for r in rows { print(r.len(), r); }
    print(csv.write(rows));
    let recs = csv.parse_records("a,b\n1,2\n3\n")?;
    for m in recs { print(m); }
    print(csv.parse("")?.len(), csv.parse("x")?.len());
    for bad in ["\"abc", "\"a\"b,c"] {
        match csv.parse(bad) { case Ok(r) -> print("ok?"); case Err(e) -> print(e); }
    }
    for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar", "日本語"] {
        let b = encoding.base64(s);
        print("[" + b + "]", encoding.from_base64(b)?, encoding.hex(s), encoding.from_hex(encoding.hex(s))?);
    }
    print(encoding.from_base64("Zm9vYg")?, encoding.from_base64("Zm9v\nYmFy")?);
    for bad in ["Zm9v!", "Z", "Zm=9"] {
        match encoding.from_base64(bad) { case Ok(r) -> print("ok?", r); case Err(e) -> print(e); }
    }
    for bad in ["abc", "zz", "ff"] {
        match encoding.from_hex(bad) { case Ok(r) -> print("ok?", r); case Err(e) -> print(e); }
    }
    let u8[] raw = [0, 255, 128, 1];
    print(encoding.base64_bytes(raw), encoding.hex_bytes(raw), encoding.from_base64_bytes("AP+AAQ==")?, encoding.from_hex_bytes("00FF8001")?);
    Ok(())
}
fn main() { match go() { case Ok(u) -> {} case Err(e) -> print("err", e); } }
