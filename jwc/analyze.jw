// IR の上の静的解析（Rust 版の src/ir/analyze.rs にあたる）: 借りた先が必ず生きていると証明できた `*p` の世代チェックを消す。
//
// 事実は変数ごとに数 1 つで持つ（`i64[]`。位置が変数の番号）:
//   0 何も分からない / 1 Own（ムーブされていない own を持っている）/ 2 Pinned（関数の中ずっと先が生きている引数）/
//   3 + 2x RefTo(x)（own の変数 x の先を借りた ref）/ 4 + 2x RefSlot(x)（変数 x そのものを借りた ref）
// 基本ブロックの上の前向きのデータフロー解析で、合流では両方で成り立つ事実だけを残す。
use ir;
use ty;

const OWN = 1;
const PINNED = 2;

fn i64 ref_to(i64 x) { 3 + 2 * x }

fn i64 ref_slot(i64 x) { 4 + 2 * x }

fn bool is_ref_to(i64 f) { f >= 3 && (f - 3) % 2 == 0 }

fn bool is_ref_slot(i64 f) { f >= 4 && (f - 4) % 2 == 0 }

fn i64 target(i64 f) { if is_ref_to(f) { (f - 3) / 2 } else { (f - 4) / 2 } }

/// 両方の道で成り立つ事実だけを残す（合流点）
fn i64[] meet(ref i64[] a, ref i64[] b) {
    let i64[] mut out = [];
    for (i, x) in a { out.push(if x == b[i] { x } else { 0 }); }
    out
}

/// 変数 x がなくなった（drop・ムーブ）。それを借りた ref の事実も消す
fn kill_all(ref mut i64[] facts, i64 x) {
    facts[x] = 0;
    let a = ref_to(x);
    let b = ref_slot(x);
    for i in range(facts.len()) {
        if facts[i] == a || facts[i] == b { facts[i] = 0; }
    }
}

/// 変数 x に入れ直した。古い own は解放されるが、変数の場所はそのまま
fn kill_value(ref mut i64[] facts, i64 x) {
    facts[x] = 0;
    let a = ref_to(x);
    for i in range(facts.len()) {
        if facts[i] == a { facts[i] = 0; }
    }
}

/// この事実を持つ値は、今、借りた先が生きている ref か
fn bool is_live(ref i64[] facts, i64 f) {
    if f == PINNED || is_ref_slot(f) { return true; }
    if is_ref_to(f) { return facts[target(f)] == OWN; }
    false
}

fn i64[] successors(ref ir.Term t) {
    match ref t {
        case Goto(b) -> [b];
        case Branch(c, a, b) -> [a, b];
        case Step(c, s, a, b) -> [a, b];
        case Switch(p, vs, bbs, d) -> {
            let i64[] mut out = bbs.map((x) -> x);
            out.push(d);
            out
        }
        default -> [];
    }
}

/// 命令を順にたどる。`set` なら場所の検査を決めて書き込み、`rec` なら呼び出しの引数が安全かを記録する
struct Cx {
    bool set;
    bool rec;
    // 関数ごとの引数の数
    i64[] arity;
    // 関数ごとの「呼ばれたか」と、引数ごとの「いつも安全な ref が渡されたか」
    bool[] called;
    bool[][] calls;
    // 変数ごとの「own の型か」「own か ref の型か」
    bool[] l_own;
    bool[] l_ptr;

    fn mut inst(ref mut ir.Inst i, ref mut i64[] facts) {
        match ref mut i {
            case Assign(pl, v, s, w) -> {
                // 値を先に計算し、そのあとで場所を求める（exec と同じ順）
                let mut f = rvalue(v, ref mut facts);
                place(pl, ref mut facts);
                if pl.proj.len() == 0 {
                    let x = pl.local;
                    kill_value(ref mut facts, x);
                    // own の型の変数に入れた値は、その変数が持つ own
                    if l_own[x] { f = OWN; }
                    let self_ref = (is_ref_to(f) || is_ref_slot(f)) && target(f) == x;
                    if f != 0 && !self_ref { facts[x] = f; }
                }
            }
            case Drop(l, s, w) -> kill_all(ref mut facts, l);
            case Discard(v, s, w) -> {
                operand(v, ref mut facts);
            }
        }
    }

    fn mut term(ref mut ir.Term t, ref mut i64[] facts) {
        match ref mut t {
            case Branch(o, a, b) -> {
                operand(o, ref mut facts);
            }
            case Return(o) -> {
                operand(o, ref mut facts);
            }
            case Step(c, o, a, b) -> {
                operand(o, ref mut facts);
            }
            case Switch(p, vs, bbs, d) -> place(p, ref mut facts);
            default -> {}
        }
    }

    /// 場所をたどる。先頭の `*` の検査を決める（ほかの `*` は実行時に検査する）
    fn mut place(ref mut ir.Place p, ref mut i64[] facts) {
        let f = facts[p.local];
        let safe = f == OWN || is_live(facts, f);
        for i in range(p.proj.len()) {
            let mut is_deref = false;
            let mut sp = 0;
            match ref p.proj[i] {
                case Deref(c, s) -> {
                    is_deref = true;
                    sp = s;
                }
                default -> {}
            }
            if set && is_deref { p.proj[i] = ir.Proj.Deref(!(i == 0 && safe), sp); }
        }
        for i in range(p.proj.len()) {
            match ref mut p.proj[i] {
                case Index(k, s, a) -> {
                    operand(k, ref mut facts);
                }
                default -> {}
            }
        }
    }

    /// 値を読む。ムーブなら変数の事実を消す。読んだ値について分かることを返す
    fn mut i64 operand(ref mut ir.Operand o, ref mut i64[] facts) {
        match ref mut o {
            case Const(c) -> 0;
            case Copy(p) -> {
                let f = if p.proj.len() == 0 { facts[p.local] } else { 0 };
                place(p, ref mut facts);
                f
            }
            case Move(l, s) -> {
                let f = facts[l];
                kill_all(ref mut facts, l);
                f
            }
            case Read(l, s) -> {
                let f = facts[l];
                kill_all(ref mut facts, l);
                f
            }
        }
    }

    /// 値を順に読む。呼び出しの引数として安全か（読む前の事実で決める）も返す
    fn mut bool[] operands(ref mut ir.Operand[] os, ref mut i64[] facts) {
        let i64[] mut fs = [];
        for o in os {
            fs.push(match ref o {
                case Copy(p) -> if p.proj.len() == 0 { facts[p.local] } else { 0 };
                case Move(l, s) -> facts[l];
                case Read(l, s) -> facts[l];
                default -> 0;
            });
        }
        // `f(ref a, a)` のように後の引数でムーブされるものは、前の命令で事実が消えている
        let bool[] mut safe = [];
        for f in fs { safe.push(is_live(facts, f)); }
        for j in range(os.len()) {
            operand(ref mut os[j], ref mut facts);
        }
        safe
    }

    fn mut record(i64 fi, ref bool[] safe) {
        if !rec || arity[fi] != safe.len() { return; }
        if !called[fi] {
            called[fi] = true;
            let bool[] mut all = [];
            for s in safe { all.push(true); }
            calls[fi] = all;
        }
        for (j, s) in safe {
            calls[fi][j] = calls[fi][j] && s;
        }
    }

    /// `ref 場所` で作った ref について分かること
    fn i64 ref_fact(ref ir.Place pl, bool follows, ref i64[] facts) {
        let root = facts[pl.local];
        // 添字は通さない（リストの要素はリストの中身の区画にあり、長さが変わると無効になる）
        if pl.proj.len() == 0 {
            if !follows { return ref_slot(pl.local); }
            if root == OWN { return ref_to(pl.local); }
            // ref の借り直しは同じ先
            return root;
        }
        if follows { return 0; }
        let mut first = 0;
        match ref pl.proj[0] {
            case Deref(c, s) -> first = 1;
            case Field(i, s) -> first = 2;
            case Index(k, s, a) -> first = 2;
            default -> {}
        }
        let from = if first == 1 { 1 } else { 0 };
        for i in range(from, pl.proj.len()) {
            let field = match ref pl.proj[i] {
                case Field(x, s) -> true;
                default -> false;
            };
            if !field { return 0; }
        }
        if first == 1 {
            if root == OWN { return ref_to(pl.local); }
            if is_live(facts, root) { return root; }
            return 0;
        }
        if first == 2 {
            if l_ptr[pl.local] { return 0; }
            return ref_slot(pl.local);
        }
        0
    }

    fn mut i64 rvalue(ref mut ir.Rvalue r, ref mut i64[] facts) {
        match ref mut r {
            case Use(o) -> operand(o, ref mut facts);
            case Bin(op, a, b, s) -> {
                operand(a, ref mut facts);
                operand(b, ref mut facts);
                0
            }
            case Un(op, a, s) -> {
                operand(a, ref mut facts);
                0
            }
            case Cast(a, t) -> {
                operand(a, ref mut facts);
                0
            }
            case Repeat(a, n, l) -> {
                operand(a, ref mut facts);
                0
            }
            case Show(a, t, s) -> {
                operand(a, ref mut facts);
                0
            }
            case Own(a) -> {
                operand(a, ref mut facts);
                OWN
            }
            case Ref(pl, m, follows, w, s) -> {
                let f = ref_fact(pl, follows, facts);
                place(pl, ref mut facts);
                f
            }
            case Struct(n, ops) -> {
                operands(ops, ref mut facts);
                0
            }
            case Enum(v, ops, c) -> {
                operands(ops, ref mut facts);
                0
            }
            case Array(ops, l) -> {
                operands(ops, ref mut facts);
                0
            }
            case Builtin(n, ops, s) -> {
                operands(ops, ref mut facts);
                0
            }
            case Map(ks, vs, s) -> {
                for j in range(ks.len()) {
                    operand(ref mut ks[j], ref mut facts);
                    operand(ref mut vs[j], ref mut facts);
                }
                0
            }
            case Call(fi, ops, s) -> {
                let safe = operands(ops, ref mut facts);
                record(fi, safe);
                0
            }
            case Closure(fi, ops) -> {
                if rec && ops.len() == 0 {
                    // 名前のある関数を値にした。どこから何が渡されるか分からない
                    let bool[] mut none = [];
                    for i in range(arity[fi]) { none.push(false); }
                    record(fi, none);
                }
                operands(ops, ref mut facts);
                0
            }
            case CallValue(fv, ops, s) -> {
                operands(ops, ref mut facts);
                operand(fv, ref mut facts);
                0
            }
            case CallDyn(sn, fns, th, m, w, ops, s) -> {
                let safe = operands(ops, ref mut facts);
                let this_safe = is_live(facts, ref_fact(th, false, facts));
                place(th, ref mut facts);
                let bool[] mut all = [this_safe];
                for x in safe { all.push(x); }
                for fi in fns { record(fi, all); }
                0
            }
            case SeqOp(n, pl, ops, s, a) -> {
                operands(ops, ref mut facts);
                place(pl, ref mut facts);
                0
            }
            case CopyOut(pl, w, s) -> {
                place(pl, ref mut facts);
                0
            }
            case Take(pl) -> {
                place(pl, ref mut facts);
                0
            }
            case Items(pl, w, s) -> {
                place(pl, ref mut facts);
                0
            }
            case Keys(pl) -> {
                place(pl, ref mut facts);
                0
            }
        }
    }
}

fn Cx new_cx(bool set, bool rec, ref i64[] arity, ref ir.Func f) {
    let bool[] mut l_own = [];
    let bool[] mut l_ptr = [];
    for l in f.locals {
        let o = ty.is(l.t, "Own");
        l_own.push(o);
        l_ptr.push(o || ty.is(l.t, "Ref"));
    }
    let bool[] mut called = [];
    let bool[][] mut calls = [];
    if rec {
        for a in arity {
            called.push(false);
            calls.push([]);
        }
    }
    Cx { set: set, rec: rec, arity: arity.map((x) -> x), called: called, calls: calls, l_own: l_own, l_ptr: l_ptr }
}

/// 各ブロックの入口で成り立つ事実（どこからも来ないブロックは `has` が false）
struct Entry {
    bool[] has;
    i64[][] facts;
}

fn Entry fixpoint(ref mut ir.Func f, ref bool[] pinned) {
    let n = f.blocks.len();
    let bool[] mut has = [];
    let i64[][] mut entry = [];
    for i in range(n) {
        has.push(false);
        entry.push([]);
    }
    let i64[] mut start = [];
    for l in f.locals { start.push(0); }
    for i in range(f.params) {
        if i < pinned.len() && pinned[i] {
            start[i] = PINNED;
        } else if ty.is(f.locals[i].t, "Own") && i < f.params - f.captures {
            start[i] = OWN;
        }
    }
    has[0] = true;
    entry[0] = start;
    let i64[] noarity = [];
    let mut cx = new_cx(false, false, noarity, f);
    let i64[] mut work = [0];
    while work.len() > 0 {
        let b = match work.pop() {
            case Some(x) -> x;
            case None -> 0;
        };
        let mut facts = entry[b].map((x) -> x);
        for k in range(f.blocks[b].insts.len()) {
            cx.inst(ref mut f.blocks[b].insts[k], ref mut facts);
        }
        cx.term(ref mut f.blocks[b].term, ref mut facts);
        for s in successors(f.blocks[b].term) {
            let next = if has[s] { meet(entry[s], facts) } else { facts.map((x) -> x) };
            let mut same = has[s];
            if same {
                for (i, x) in next {
                    if entry[s][i] != x { same = false; }
                }
            }
            if !same {
                has[s] = true;
                entry[s] = next;
                work.push(s);
            }
        }
    }
    Entry { has: has, facts: entry }
}

/// 全体を解析して、各 `Proj::Deref` の検査を書き込む
pub fn analyze(ref mut ir.Program prog) {
    let n = prog.fns.len();
    // 引数ごとに「Pinned か」。楽観的に全部 true から始め、反例が出たら false にする（減る一方なので止まる）
    let i64[] mut arity = [];
    let bool[][] mut pinned = [];
    for f in prog.fns {
        arity.push(f.params);
        let bool[] mut ps = [];
        for i in range(f.params) { ps.push(true); }
        pinned.push(ps);
    }
    loop {
        let bool[] mut called = [];
        let bool[][] mut calls = [];
        for i in range(n) {
            called.push(false);
            calls.push([]);
        }
        for fi in range(n) {
            let entry = fixpoint(ref mut prog.fns[fi], pinned[fi]);
            let mut cx = new_cx(true, true, arity, prog.fns[fi]);
            cx.called = called.drain();
            cx.calls = calls.drain();
            for b in range(prog.fns[fi].blocks.len()) {
                if !entry.has[b] { continue; }
                let mut facts = entry.facts[b].map((x) -> x);
                for k in range(prog.fns[fi].blocks[b].insts.len()) {
                    cx.inst(ref mut prog.fns[fi].blocks[b].insts[k], ref mut facts);
                }
                cx.term(ref mut prog.fns[fi].blocks[b].term, ref mut facts);
            }
            called = cx.called.drain();
            calls = cx.calls.drain();
        }
        // 一度も呼ばれない関数の引数（main・クロージャ）は何も仮定しない
        let bool[][] mut next = [];
        let mut same = true;
        for fi in range(n) {
            let bool[] mut ps = [];
            for i in range(arity[fi]) { ps.push(called[fi] && calls[fi][i]); }
            for (i, x) in ps {
                if pinned[fi][i] != x { same = false; }
            }
            next.push(ps);
        }
        if same { break; }
        pinned = next;
    }
}
