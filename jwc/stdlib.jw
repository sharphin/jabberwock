// 標準ライブラリ（リポジトリの std/）を文字列にしたもの。`use std.名前;` で読む（modules.jw）。
// 手で書き換えない: std/ を直したら `JWC_REGEN=1 cargo test --test jwc stdlib_is_up_to_date` で作り直す。

/// `std.名前` のソース
pub fn Option<str> source(str name) {
    if name == "cli" {
        return Some("""
// std.cli: コマンドライン引数を読む。`use std.cli;` で次のように使う。
//   let mut p = cli.Parser.new("wc", "行を数える");
//   p.flag("verbose", "v", "詳しく出す");
//   p.option("out", "o", "出力先", "-");   // 値をとるオプション（4 つめは既定値。なければ ""）
//   p.arg("file", "読むファイル");          // 位置引数の名前（使い方の表示だけに使う）
//   let a = match p.parse(args()) {{
//       case Ok(a) -> a;
//       case Err(e) -> {{ eprint(e); eprint(p.usage()); exit(2); }}
//   }};
//   if a.help {{ print(p.usage()); exit(0); }}
//   a.has("verbose")  a.get("out")  a.get_int("n")  a.rest（位置引数）
// 書き方: `--name` `--name=値` `--name 値` `-v` `-vq`（まとめた短い名前） `-o 値` `-o値`。`--` のあとはすべて位置引数。
// `-` だけ・`-5` のように数字が続くものは位置引数。`-h` / `--help` は `help` を立てる（自分で -h を決めたらそちら）。

/// `-5` のように `-` のすぐあとが数字か
fn bool is_number_like(str x) {{
    let cs = x.chars();
    cs.len() > 1 && cs[1].is_digit()
}}

/// 表示の幅（ASCII は 1、日本語など U+1100 以上は 2 とみなす）
fn i64 width_of(str s) {{
    let mut w = 0;
    for c in s.chars() {{
        w += if c as i64 >= 0x1100 {{ 2 }} else {{ 1 }};
    }}
    w
}}

struct Spec {{
    str long;
    str short;
    str help;
    bool takes_value;
    str fallback;
}}

/// 読んだ結果
pub struct Args {{
    // 書かれたフラグ・オプションの名前（長い名前）
    bool[str] given;
    // オプションの値（書かれなかったものは既定値。既定値のないものは入らない）
    str[str] values;
    // 位置引数（書かれた順）
    str[] rest;
    // `-h` か `--help` があった
    bool help;

    /// フラグかオプションが書かれたか
    fn bool has(str name) {{ given.contains(name) }}

    /// オプションの値（書かれなければ既定値。既定値もなければ ""）
    fn str get(str name) {{
        if values.contains(name) {{ return values[name]; }}
        ""
    }}

    /// オプションの値を整数にしたもの（値がない・整数でなければ None）
    fn Option<i64> get_int(str name) {{
        if values.contains(name) {{ return values[name].to_int(); }}
        None
    }}
}}

pub struct Parser {{
    str prog;
    str about;
    Spec[] specs;
    str[] arg_names;
    str[] arg_helps;

    /// prog はプログラムの名前、about は 1 行の説明（使い方の表示に出す）
    static fn Parser new(str prog, str about) {{ Parser {{ prog: prog, about: about, specs: [], arg_names: [], arg_helps: [] }} }}

    /// 値をとらないフラグ（short は 1 文字か ""）
    fn mut flag(str long, str short, str help) {{
        specs.push(Spec {{ long: long, short: short, help: help, takes_value: false, fallback: "" }});
    }}

    /// 値をとるオプション（fallback が "" なら既定値なし）
    fn mut option(str long, str short, str help, str fallback) {{
        specs.push(Spec {{ long: long, short: short, help: help, takes_value: true, fallback: fallback }});
    }}

    /// 位置引数の名前と説明（使い方の表示だけに使う。数は調べない）
    fn mut arg(str arg_name, str help) {{
        arg_names.push(arg_name);
        arg_helps.push(help);
    }}

    /// 引数を読む（`args()` をそのまま渡す。プログラムの名前は入っていない）。知らないオプション・値がないときは Err
    fn Result<Args, str> parse(ref str[] argv) {{
        let mut a = Args {{ given: [], values: [], rest: [], help: false }};
        for s in specs {{
            if s.takes_value && s.fallback != "" {{ a.values[s.long] = s.fallback; }}
        }}
        let n = argv.len();
        let mut i = 0;
        let mut only_rest = false;
        while i < n {{
            let x = argv[i];
            i++;
            if only_rest || x == "-" || !x.starts_with("-") || is_number_like(x) {{
                a.rest.push(x);
                continue;
            }}
            if x == "--" {{
                only_rest = true;
                continue;
            }}
            if x.starts_with("--") {{
                let body = x.slice(2, x.len());
                let mut key = body;
                let mut val = "";
                let mut has_val = false;
                match body.find("=") {{
                    case Some(k) -> {{
                        key = body.slice(0, k);
                        val = body.slice(k + 1, body.len());
                        has_val = true;
                    }}
                    case None -> {{}}
                }}
                let k = find_long(key);
                if k < 0 {{
                    if key == "help" && !has_val {{ a.help = true; continue; }}
                    return Err("知らないオプションです: --" + key);
                }}
                let s = ref specs[k];
                if !s.takes_value {{
                    if has_val {{ return Err("--" + key + " は値をとりません"); }}
                    a.given[key] = true;
                    continue;
                }}
                if !has_val {{
                    if i >= n {{ return Err("--" + key + " に値がありません"); }}
                    val = argv[i];
                    i++;
                }}
                a.given[key] = true;
                a.values[key] = val;
                continue;
            }}
            // 短い名前（まとめて書ける。値をとるものはそこで終わり、残りか次の引数が値）
            let cs = x.chars();
            let mut j = 1;
            while j < cs.len() {{
                let c = cs[j].to_str();
                j++;
                let k = find_short(c);
                if k < 0 {{
                    if c == "h" {{ a.help = true; continue; }}
                    return Err("知らないオプションです: -" + c);
                }}
                let s = ref specs[k];
                a.given[s.long] = true;
                if s.takes_value {{
                    let mut val = x.slice(j, x.len());
                    if j >= cs.len() {{
                        if i >= n {{ return Err("-" + c + " に値がありません"); }}
                        val = argv[i];
                        i++;
                    }}
                    a.values[s.long] = val;
                    break;
                }}
            }}
        }}
        Ok(a)
    }}

    fn i64 find_long(str key) {{
        for (i, s) in specs {{
            if s.long == key {{ return i; }}
        }}
        -1
    }}

    fn i64 find_short(str c) {{
        for (i, s) in specs {{
            if s.short != "" && s.short == c {{ return i; }}
        }}
        -1
    }}

    /// 使い方の説明（最後に改行はつけない）
    fn str usage() {{
        let mut head = "使い方: " + prog;
        if specs.len() > 0 {{ head += " [オプション]"; }}
        for x in arg_names {{ head += " <" + x + ">"; }}
        let mut out = head;
        if about != "" {{ out += "\\n" + about; }}
        let str[] mut lefts = [];
        let str[] mut helps = [];
        for (i, x) in arg_names {{
            lefts.push("<" + x + ">");
            helps.push(arg_helps[i]);
        }}
        let first_opt = lefts.len();
        for s in specs {{
            let mut l = if s.short != "" {{ "-" + s.short + ", " }} else {{ "    " }};
            l += "--" + s.long;
            if s.takes_value {{ l += " <値>"; }}
            let mut h = s.help;
            if s.takes_value && s.fallback != "" {{ h += "（既定: " + s.fallback + "）"; }}
            lefts.push(l);
            helps.push(h);
        }}
        if find_short("h") < 0 && find_long("help") < 0 {{
            lefts.push("-h, --help");
            helps.push("この説明を出す");
        }}
        let mut width = 0;
        for l in lefts {{ width = width.max(width_of(l)); }}
        for (i, l) in lefts {{
            if i == 0 && first_opt > 0 {{ out += "\\n\\n引数:"; }}
            if i == first_opt {{ out += "\\n\\nオプション:"; }}
            out += "\\n  " + l + " ".repeat(width - width_of(l) + 2) + helps[i];
        }}
        out
    }}
}}
""");
    }
    if name == "fs" {
        return Some("""
// std.fs: ファイルとディレクトリ。`use std.fs;` で `fs.exists("a.txt")` `fs.list_dir(".")?` のように使う。
// 中身を読み書きするのは組み込みの `read_file` / `write_file`（UTF-8 の文字列だけ）。
// パスの区切りは `/`（分けるときは `\\` も区切りとみなす）。エラーの文は OS によらず同じ。

/// ファイルかディレクトリがあるか（リンクはたどった先を見る）
pub fn bool exists(str path) {{ __fs_exists(path) }}

/// ディレクトリの中の名前（`.` と `..` は除く。名前の順）
pub fn Result<str[], str> list_dir(str path) {{ __fs_list(path) }}

/// ディレクトリを作る（親はあること。もうあれば Err）
pub fn Result<(), str> make_dir(str path) {{ __fs_make_dir(path) }}

/// ディレクトリを親から順に作る（もうあれば何もしない）
pub fn Result<(), str> make_dirs(str path) {{
    if is_dir(path) {{ return Ok(()); }}
    let up = parent(path);
    if up != "" && !is_dir(up) {{ make_dirs(up)?; }}
    make_dir(path)
}}

/// ファイルか、空のディレクトリを消す（リンクはリンクそのものを消す）
pub fn Result<(), str> remove(str path) {{ __fs_remove(path) }}

/// 名前を変える（別のディレクトリへも動かせる）。to があれば置き換える
pub fn Result<(), str> rename(str from, str to) {{ __fs_rename(from, to) }}

/// ファイルの後ろに text を足す（なければ作る）
pub fn Result<(), str> append_text(str path, str text) {{ __fs_append(path, text) }}

/// ファイル・ディレクトリの情報
pub struct Info {{
    // 中身の大きさ（バイト。ファイルでなければ 0）
    i64 size;
    bool is_file;
    bool is_dir;
    // path そのものがリンクか。ほかの欄はたどった先のもの（先がなければ is_file も is_dir も false）
    bool is_link;
    // 更新時刻（1970-01-01 UTC からのミリ秒。Windows は秒の単位）
    i64 modified_ms;
}}

/// 情報を読む（なければ Err）
pub fn Result<Info, str> stat(str path) {{
    let v = __fs_stat(path)?;
    Ok(Info {{ size: v[1], is_file: v[0] == 0, is_dir: v[0] == 1, is_link: v[3] == 1, modified_ms: v[2] }})
}}

/// ファイルか（なければ false）
pub fn bool is_file(str path) {{
    match stat(path) {{
        case Ok(i) -> i.is_file;
        case Err(e) -> false;
    }}
}}

/// ディレクトリか（なければ false）
pub fn bool is_dir(str path) {{
    match stat(path) {{
        case Ok(i) -> i.is_dir;
        case Err(e) -> false;
    }}
}}

/// path の下にあるファイルすべてのパス（`join(path, ...)` の形。ディレクトリの中は名前の順に深さ優先。リンクのディレクトリには入らない）
pub fn Result<str[], str> walk(str path) {{
    let str[] mut out = [];
    walk_into(path, ref mut out)?;
    Ok(out)
}}

fn Result<(), str> walk_into(str dir, ref mut str[] out) {{
    for name in list_dir(dir)? {{
        let p = join(dir, name);
        let info = stat(p)?;
        if info.is_dir && !info.is_link {{
            walk_into(p, out)?;
        }} else if info.is_file {{
            out.push(p);
        }}
    }}
    Ok(())
}}

// ---------------------------------------------------------------- パス（文字列だけで決める。ファイルは見ない）

/// a と b をつなぐ（b が `/` で始まれば b のまま。a が空なら b）
pub fn str join(str a, str b) {{
    if a == "" || b.starts_with("/") {{ return b; }}
    if a.ends_with("/") || a.ends_with("\\\\") {{ return a + b; }}
    a + "/" + b
}}

/// 最後の区切り（`/` か `\\`）の位置。なければ -1
fn i64 last_sep(str p) {{
    let cs = p.chars();
    let mut i = cs.len() - 1;
    while i >= 0 {{
        if cs[i] == '/' || cs[i] == '\\\\' {{ return i; }}
        i--;
    }}
    -1
}}

/// 親のディレクトリ（`a/b/c.txt` → `a/b`、`c.txt` → ``、`/c` → `/`）
pub fn str parent(str path) {{
    let i = last_sep(path);
    if i < 0 {{ return ""; }}
    if i == 0 {{ return path.slice(0, 1); }}
    path.slice(0, i)
}}

/// 最後の名前（`a/b/c.txt` → `c.txt`）
pub fn str file_name(str path) {{ path.slice(last_sep(path) + 1, path.len()) }}

/// 拡張子（`c.tar.gz` → `gz`。点で始まる名前 `.env` や点のない名前は ``）
pub fn str ext(str path) {{
    let name = file_name(path);
    let cs = name.chars();
    let mut i = cs.len() - 1;
    while i > 0 {{
        if cs[i] == '.' {{ return name.slice(i + 1, name.len()); }}
        i--;
    }}
    ""
}}

/// 拡張子を除いた名前（`a/c.tar.gz` → `c.tar`）
pub fn str stem(str path) {{
    let name = file_name(path);
    let e = ext(path);
    if e == "" {{ return name; }}
    name.slice(0, name.len() - e.len() - 1)
}}
""");
    }
    if name == "json" {
        return Some("""
// std.json: JSON を読む・書く。`use std.json;` で `json.parse(text)` / `json.stringify(v)` のように使う。
// 値は enum `json.Value`。配列と object は own で持つ（借りた match で受け取れるように）。object は入れた順を覚える。

pub enum Value {{
    Null;
    Bool(bool b);
    Num(f64 n);
    Str(str s);
    Arr(own (own Value)[] items);
    Obj(own (own Value)[str] fields);
}}

/// JSON の文字列を読む。読めなければ Err（何文字目で何が悪いか）
pub fn Result<own Value, str> parse(str text) {{
    let mut p = Reader {{ text: text, cs: text.chars(), i: 0, depth: 0 }};
    let v = p.value()?;
    p.space();
    if p.i < p.cs.len() {{
        return Err(p.fail("値のあとに余分な文字があります"));
    }}
    Ok(v)
}}

/// object のキー key の文字列（なければ・文字列でなければ None）
pub fn Option<str> get_str(ref Value v, str key) {{
    match v {{
        case Obj(f) -> {{
            for (k, x) in f {{
                if k == key {{
                    return match x {{
                        case Str(s) -> Some(s);
                        default -> None;
                    }};
                }}
            }}
            None
        }}
        default -> None;
    }}
}}

/// object のキー key の数（なければ・数でなければ None）
pub fn Option<f64> get_num(ref Value v, str key) {{
    match v {{
        case Obj(f) -> {{
            for (k, x) in f {{
                if k == key {{
                    return match x {{
                        case Num(n) -> Some(n);
                        default -> None;
                    }};
                }}
            }}
            None
        }}
        default -> None;
    }}
}}

/// object のキー key の真偽値（なければ・真偽値でなければ None）
pub fn Option<bool> get_bool(ref Value v, str key) {{
    match v {{
        case Obj(f) -> {{
            for (k, x) in f {{
                if k == key {{
                    return match x {{
                        case Bool(b) -> Some(b);
                        default -> None;
                    }};
                }}
            }}
            None
        }}
        default -> None;
    }}
}}

/// JSON の文字列にする（空白なし）
pub fn str stringify(ref Value v) {{
    match v {{
        case Null -> "null";
        case Bool(b) -> if b {{ "true" }} else {{ "false" }};
        case Num(n) -> number(n);
        case Str(s) -> quote(s);
        case Arr(items) -> {{
            let str[] mut parts = [];
            for x in items {{ parts.push(stringify(x)); }}
            "[" + parts.join(",") + "]"
        }}
        case Obj(fields) -> {{
            let str[] mut parts = [];
            for (k, x) in fields {{ parts.push(quote(k) + ":" + stringify(x)); }}
            "{{{{" + parts.join(",") + "}}}}"
        }}
    }}
}}

/// 字下げつきの JSON の文字列にする（indent は字下げの空白の数）
pub fn str pretty(ref Value v, i64 indent) {{
    pretty_at(v, indent, 0)
}}

fn str pretty_at(ref Value v, i64 indent, i64 level) {{
    let inner = " ".repeat(indent * (level + 1));
    let outer = " ".repeat(indent * level);
    match v {{
        case Arr(items) -> {{
            if items.len() == 0 {{ return "[]"; }}
            let str[] mut parts = [];
            for x in items {{ parts.push(inner + pretty_at(x, indent, level + 1)); }}
            "[\\n" + parts.join(",\\n") + "\\n" + outer + "]"
        }}
        case Obj(fields) -> {{
            if fields.len() == 0 {{ return "{{{{}}}}"; }}
            let str[] mut parts = [];
            for (k, x) in fields {{ parts.push(inner + quote(k) + ": " + pretty_at(x, indent, level + 1)); }}
            "{{{{\\n" + parts.join(",\\n") + "\\n" + outer + "}}}}"
        }}
        default -> stringify(v);
    }}
}}

/// 文字列を JSON の文字列の書き方にする（`"` で囲み、`"` `\\` と制御文字をエスケープする）
pub fn str quote(str s) {{
    let mut out = "\\"";
    for c in s.chars() {{
        let k = c as i64;
        if c == '"' {{ out += "\\\\\\""; }}
        else if c == '\\\\' {{ out += "\\\\\\\\"; }}
        else if c == '\\n' {{ out += "\\\\n"; }}
        else if c == '\\r' {{ out += "\\\\r"; }}
        else if c == '\\t' {{ out += "\\\\t"; }}
        else if k < 32 {{ out += "\\\\u" + hex4(k); }}
        else {{ out += c.to_str(); }}
    }}
    out + "\\""
}}

fn str hex4(i64 k) {{
    let digits = "0123456789abcdef";
    let mut out = "";
    let mut v = k;
    for i in range(4) {{
        out = digits.slice(v % 16, v % 16 + 1) + out;
        v = v / 16;
    }}
    out
}}

/// 数の書き方（整数なら小数点なし。NaN と無限大は JSON にないので null）
fn str number(f64 n) {{
    if n.is_nan() || n - n != 0.0 {{ return "null"; }}
    if n == n.trunc() && n.abs() < 1000000000000000.0 {{ return "{{n as i64}}"; }}
    "{{n}}"
}}

struct Reader {{
    str text;
    char[] cs;
    i64 i;
    i64 depth;

    fn str fail(str why) {{
        "JSON を読めません（{{i + 1}} 文字目）: {{why}}"
    }}

    fn mut space() {{
        while i < cs.len() && cs[i].is_space() {{ i += 1; }}
    }}

    /// 今の文字（終わりなら `'\\0'`。JSON の文字列の外に \\0 は書けない）
    fn char peek() {{
        if i < cs.len() {{ cs[i] }} else {{ '\\0' }}
    }}

    fn bool at_end() {{ i >= cs.len() }}

    fn mut Result<own Value, str> value() {{
        space();
        if at_end() {{ return Err(fail("値がありません")); }}
        let c = peek();
        if c == '{{' || c == '[' {{
            depth += 1;
            if depth > 500 {{ return Err(fail("入れ子が深すぎます")); }}
            let r = if c == '{{' {{ object()? }} else {{ array()? }};
            depth -= 1;
            return Ok(r);
        }}
        if c == '"' {{ return Ok(own Value.Str(string()?)); }}
        if c == 't' {{ word("true")?; return Ok(own Value.Bool(true)); }}
        if c == 'f' {{ word("false")?; return Ok(own Value.Bool(false)); }}
        if c == 'n' {{ word("null")?; return Ok(own Value.Null); }}
        if c == '-' || c.is_digit() {{ return Ok(own Value.Num(num()?)); }}
        Err(fail("`{{c}}` から始まる値はありません"))
    }}

    fn mut Result<(), str> word(str w) {{
        for c in w.chars() {{
            if peek() != c {{ return Err(fail("`{{w}}` と書くところです")); }}
            i += 1;
        }}
        Ok(())
    }}

    fn mut Result<f64, str> num() {{
        let start = i;
        if peek() == '-' {{ i += 1; }}
        let digits_from = i;
        while !at_end() && peek().is_digit() {{ i += 1; }}
        if i == digits_from {{ return Err(fail("数の書き方がおかしいです")); }}
        if i - digits_from > 1 && cs[digits_from] == '0' {{ return Err(fail("数の先頭に 0 は書けません")); }}
        if peek() == '.' {{
            i += 1;
            let f = i;
            while !at_end() && peek().is_digit() {{ i += 1; }}
            if i == f {{ return Err(fail("小数点のあとに数字がありません")); }}
        }}
        if peek() == 'e' || peek() == 'E' {{
            i += 1;
            if peek() == '+' || peek() == '-' {{ i += 1; }}
            let e = i;
            while !at_end() && peek().is_digit() {{ i += 1; }}
            if i == e {{ return Err(fail("指数に数字がありません")); }}
        }}
        match text.slice(start, i).to_float() {{
            case Some(v) -> Ok(v);
            case None -> Err(fail("数の書き方がおかしいです"));
        }}
    }}

    fn mut Result<str, str> string() {{
        i += 1;
        let mut out = "";
        loop {{
            let c = peek();
            if at_end() {{ return Err(fail("文字列が閉じていません")); }}
            i += 1;
            if c == '"' {{ break; }}
            if (c as i64) < 32 {{ return Err(fail("文字列の中に制御文字があります")); }}
            if c != '\\\\' {{
                out += c.to_str();
                continue;
            }}
            if at_end() {{ return Err(fail("文字列が閉じていません")); }}
            let e = peek();
            i += 1;
            if e == '"' {{ out += "\\""; }}
            else if e == '\\\\' {{ out += "\\\\"; }}
            else if e == '/' {{ out += "/"; }}
            else if e == 'b' {{ out += "\\u{{8}}"; }}
            else if e == 'f' {{ out += "\\u{{c}}"; }}
            else if e == 'n' {{ out += "\\n"; }}
            else if e == 'r' {{ out += "\\r"; }}
            else if e == 't' {{ out += "\\t"; }}
            else if e == 'u' {{
                let mut code = hex()?;
                // サロゲートの組（\\ud83d\\ude00 の形）は 1 文字にする
                if code >= 55296 && code <= 56319 && peek() == '\\\\' {{
                    i += 1;
                    if peek() != 'u' {{ return Err(fail("サロゲートの組が途中です")); }}
                    i += 1;
                    let low = hex()?;
                    if low < 56320 || low > 57343 {{ return Err(fail("サロゲートの組が正しくありません")); }}
                    code = 65536 + (code - 55296) * 1024 + (low - 56320);
                }}
                match code.to_char() {{
                    case Some(ch) -> out += ch.to_str();
                    case None -> return Err(fail("文字の番号が正しくありません"));
                }}
            }} else {{
                return Err(fail("未知のエスケープ `\\\\{{e}}` です"));
            }}
        }}
        Ok(out)
    }}

    fn mut Result<i64, str> hex() {{
        let mut v = 0;
        for k in range(4) {{
            let c = peek();
            if at_end() {{ return Err(fail("\\\\u のあとに 16 進数が 4 つ要ります")); }}
            let d = c as i64;
            let mut x = -1;
            if d >= 48 && d <= 57 {{ x = d - 48; }}
            if d >= 97 && d <= 102 {{ x = d - 87; }}
            if d >= 65 && d <= 70 {{ x = d - 55; }}
            if x < 0 {{ return Err(fail("\\\\u のあとに 16 進数が 4 つ要ります")); }}
            v = v * 16 + x;
            i += 1;
        }}
        Ok(v)
    }}

    fn mut Result<own Value, str> array() {{
        i += 1;
        let (own Value)[] mut items = [];
        space();
        if peek() == ']' {{
            i += 1;
            return Ok(own Value.Arr(own items));
        }}
        loop {{
            items.push(value()?);
            space();
            let c = peek();
            i += 1;
            if c == ']' {{ break; }}
            if c != ',' {{ i -= 1; return Err(fail("`,` か `]` が要ります")); }}
        }}
        Ok(own Value.Arr(own items))
    }}

    fn mut Result<own Value, str> object() {{
        i += 1;
        let (own Value)[str] mut fields = [];
        space();
        if peek() == '}}' {{
            i += 1;
            return Ok(own Value.Obj(own fields));
        }}
        loop {{
            space();
            if peek() != '"' {{ return Err(fail("キー（文字列）が要ります")); }}
            let k = string()?;
            space();
            if peek() != ':' {{ return Err(fail("`:` が要ります")); }}
            i += 1;
            fields[k] = value()?;
            space();
            let c = peek();
            i += 1;
            if c == '}}' {{ break; }}
            if c != ',' {{ i -= 1; return Err(fail("`,` か `}}}}` が要ります")); }}
        }}
        Ok(own Value.Obj(own fields))
    }}
}}
""");
    }
    if name == "lists" {
        return Some("""
// std.lists: リストの便利な関数。`use std.lists;` で `lists.sum(xs)` のように使う。

/// 合計
pub fn i64 sum(ref i64[] a) {{
    let mut t = 0;
    for x in a {{ t += x; }}
    t
}}

/// 小数の合計
pub fn f64 sum_f64(ref f64[] a) {{
    let mut t = 0.0;
    for x in a {{ t += x; }}
    t
}}

/// いちばん小さい要素（空なら None）
pub fn Option<i64> min(ref i64[] a) {{
    if a.len() == 0 {{ return None; }}
    let mut m = a[0];
    for x in a {{ if x < m {{ m = x; }} }}
    Some(m)
}}

/// いちばん大きい要素（空なら None）
pub fn Option<i64> max(ref i64[] a) {{
    if a.len() == 0 {{ return None; }}
    let mut m = a[0];
    for x in a {{ if x > m {{ m = x; }} }}
    Some(m)
}}

/// from から to の手前までの整数のリスト
pub fn i64[] range_of(i64 from, i64 to) {{
    let i64[] mut out = [];
    for i in range(from, to) {{ out.push(i); }}
    out
}}

/// a の from から to の手前までを写したリスト（範囲は 0〜len に切り詰める）
pub fn i64[] slice(ref i64[] a, i64 from, i64 to) {{
    let i64[] mut out = [];
    let mut i = from.max(0);
    let end = to.min(a.len());
    while i < end {{
        out.push(a[i]);
        i += 1;
    }}
    out
}}

/// 文字列のリストの部分（`slice` の str 版）
pub fn str[] slice_str(ref str[] a, i64 from, i64 to) {{
    let str[] mut out = [];
    let mut i = from.max(0);
    let end = to.min(a.len());
    while i < end {{
        out.push(a[i]);
        i += 1;
    }}
    out
}}

/// b の要素をすべて a の後ろに足す（b は空になる）
pub fn extend<T>(ref mut T[] a, ref mut T[] b) {{
    b.reverse();
    while b.len() > 0 {{
        match b.pop() {{
            case Some(x) -> a.push(x);
            case None -> {{}}
        }}
    }}
}}

/// f が真になる要素があるか
pub fn bool any(ref i64[] a, fn bool(i64) f) {{
    for x in a {{ if f(x) {{ return true; }} }}
    false
}}

/// すべての要素で f が真か（空なら真）
pub fn bool all(ref i64[] a, fn bool(i64) f) {{
    for x in a {{ if !f(x) {{ return false; }} }}
    true
}}

/// 並んだリスト a で x を二分探索する。あればその位置、なければ Err(入れるべき位置)
pub fn Result<i64, i64> binary_search(ref i64[] a, i64 x) {{
    let mut lo = 0;
    let mut hi = a.len();
    while lo < hi {{
        let mid = lo + (hi - lo) / 2;
        if a[mid] == x {{ return Ok(mid); }}
        if a[mid] < x {{ lo = mid + 1; }} else {{ hi = mid; }}
    }}
    Err(lo)
}}
""");
    }
    if name == "rand" {
        return Some("""
// std.rand: 乱数（暗号には使えない）。`use std.rand;` で `let mut r = rand.Rng.seeded(42);` `r.below(6)` のように使う。
// 中身は splitmix64（64 ビットの状態を足して混ぜる）。同じ種なら、どの実行のしかたでも同じ並びになる。

pub struct Rng {{
    u64 state;

    /// 種 seed から作る（同じ種なら同じ並び）
    static fn Rng seeded(u64 seed) {{ Rng {{ state: seed }} }}

    /// 今の時刻を種にして作る（実行ごとに違う並び）
    static fn Rng from_time() {{ Rng {{ state: unix_ms() as u64 ^ ((now_ns() as u64) << 20) }} }}

    /// 次の 64 ビットの数
    fn mut u64 next() {{
        state = state + 0x9e3779b97f4a7c15;
        let mut z = state;
        z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
        z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
        z ^ (z >> 31)
    }}

    /// 0 以上 n 未満の整数（どの値も同じ確からしさ。n は 1 以上）
    fn mut i64 below(i64 n) {{
        assert(n > 0);
        let m = n as u64;
        // 余りが偏らないよう、端の数は捨てて引き直す
        let limit = (0 - m) % m;
        loop {{
            let r = next();
            if r >= limit {{ return (r % m) as i64; }}
        }}
    }}

    /// lo 以上 hi 未満の整数（hi は lo より大きい）
    fn mut i64 range(i64 lo, i64 hi) {{
        assert(hi > lo);
        let span = (hi as u64) - (lo as u64);
        let limit = (0 - span) % span;
        loop {{
            let r = next();
            if r >= limit {{ return ((lo as u64) + r % span) as i64; }}
        }}
    }}

    /// 0.0 以上 1.0 未満の小数
    fn mut f64 float() {{
        (next() >> 11) as f64 / 9007199254740992.0
    }}

    /// 確率 p で true
    fn mut bool chance(f64 p) {{
        float() < p
    }}

    /// リストの並びをばらばらにする（どの並びも同じ確からしさ）
    fn mut shuffle<T>(ref mut T[] a) {{
        let mut n = a.len();
        let mut rest = a.drain();
        while n > 0 {{
            a.push(rest.remove(below(n)));
            n -= 1;
        }}
    }}
}}
""");
    }
    if name == "strings" {
        return Some("""
// std.strings: 文字列の便利な関数。`use std.strings;` で `strings.pad_left(s, 5, "0")` のように使う。
// 長さと位置は、文字列のメソッドと同じく文字単位。

/// s の左を fill で埋めて、width 文字にする（もう width 以上ならそのまま。fill は 1 文字）
pub fn str pad_left(str s, i64 width, str fill) {{
    let n = s.len();
    if n >= width {{ return s; }}
    fill.repeat(width - n) + s
}}

/// s の右を fill で埋めて、width 文字にする
pub fn str pad_right(str s, i64 width, str fill) {{
    let n = s.len();
    if n >= width {{ return s; }}
    s + fill.repeat(width - n)
}}

/// s を真ん中に置いて、左右を fill で埋める（割り切れないときは右を多くする）
pub fn str center(str s, i64 width, str fill) {{
    let n = s.len();
    if n >= width {{ return s; }}
    let left = (width - n) / 2;
    fill.repeat(left) + s + fill.repeat(width - n - left)
}}

/// 左の空白を取る
pub fn str trim_start(str s) {{
    let cs = s.chars();
    let mut i = 0;
    while i < cs.len() && cs[i].is_space() {{ i += 1; }}
    s.slice(i, cs.len())
}}

/// 右の空白を取る
pub fn str trim_end(str s) {{
    let cs = s.chars();
    let mut j = cs.len();
    while j > 0 && cs[j - 1].is_space() {{ j -= 1; }}
    s.slice(0, j)
}}

/// 空白で区切った語（空の語は入れない）
pub fn str[] words(str s) {{
    let str[] mut out = [];
    let mut cur = "";
    for c in s.chars() {{
        if c.is_space() {{
            if cur.len() > 0 {{
                out.push(cur);
                cur = "";
            }}
        }} else {{
            cur += c.to_str();
        }}
    }}
    if cur.len() > 0 {{ out.push(cur); }}
    out
}}

/// sub が最後に現れる位置
pub fn Option<i64> rfind(str s, str sub) {{
    let Option<i64> mut found = None;
    let mut from = 0;
    loop {{
        match s.slice(from, s.len()).find(sub) {{
            case Some(i) -> {{
                found = Some(from + i);
                from = from + i + 1;
                if sub.len() == 0 || from > s.len() {{ break; }}
            }}
            case None -> break;
        }}
    }}
    found
}}

/// sub が重ならずに何回現れるか（sub が空なら 0）
pub fn i64 count(str s, str sub) {{
    if sub.len() == 0 {{ return 0; }}
    let mut n = 0;
    let mut from = 0;
    loop {{
        match s.slice(from, s.len()).find(sub) {{
            case Some(i) -> {{
                n += 1;
                from = from + i + sub.len();
            }}
            case None -> break;
        }}
    }}
    n
}}

/// 整数を base 進数（2〜36）の文字列にする。英字は小文字
pub fn str to_base(i64 x, i64 base) {{
    assert(base >= 2 && base <= 36);
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    if x == 0 {{ return "0"; }}
    let neg = x < 0;
    let mut out = "";
    let mut v = x;
    while v != 0 {{
        let mut d = v % base;
        if d < 0 {{ d = -d; }}
        out = digits.slice(d, d + 1) + out;
        v = v / base;
    }}
    if neg {{ "-" + out }} else {{ out }}
}}

/// 16 進数の文字列（`to_base(x, 16)`）
pub fn str hex(i64 x) {{
    to_base(x, 16)
}}

/// base 進数（2〜36）の文字列を読む。前に `-` を書ける。大文字も読む。読めなければ None
pub fn Option<i64> parse_int(str s, i64 base) {{
    assert(base >= 2 && base <= 36);
    let cs = s.chars();
    if cs.len() == 0 {{ return None; }}
    let mut i = 0;
    let neg = cs[0] == '-';
    if neg || cs[0] == '+' {{ i = 1; }}
    if i >= cs.len() {{ return None; }}
    let mut v = 0;
    while i < cs.len() {{
        let k = cs[i] as i64;
        let mut d = 99;
        if k >= 48 && k <= 57 {{ d = k - 48; }}
        if k >= 97 && k <= 122 {{ d = k - 97 + 10; }}
        if k >= 65 && k <= 90 {{ d = k - 65 + 10; }}
        if d >= base {{ return None; }}
        if neg {{ v = v * base - d; }} else {{ v = v * base + d; }}
        i += 1;
    }}
    Some(v)
}}
""");
    }
    None
}

