// std.secret を Windows で確かめる（手順は docs/windows-std-check.md）
use std.secret;
use std.hash;

fn main() {
    let k = "the key 0123456789".bytes();
    match secret.protect(ref k) {
        case Ok(b) -> {
            print("wrapped", b.len() > k.len());
            match secret.unprotect(ref b) {
                case Ok(k2) -> print("same", hash.equal(ref k, ref k2));
                case Err(e) -> print("unprotect", e);
            }
            let mut bad = b.map((x) -> x);
            bad[bad.len() - 1] = bad[bad.len() - 1] ^ 1;
            print("broken", secret.unprotect(ref bad));
        }
        case Err(e) -> print("protect", e);
    }
}
