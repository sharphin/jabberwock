// このファイルは gen_chrome.jw が chrome.html から作る。手で直さない。
// 外枠とのやりとりの決まりは chrome.html の先頭にある。

// 外枠の高さ（論理ピクセル）
pub fn i64 height() { 76 }

pub fn str html() {
    """<!doctype html>
<!--
外枠（タブ列・アドレス欄・ブックマーク）。エンジンが表示し、本体（browser.jw）と文字列だけでやりとりする。
- 外枠 → 本体（ChromeMessage）: "go <打った文字>" / "back" / "forward" / "reload" / "stop" /
  "newtab" / "select <タブ>" / "close <タブ>" / "bookmark" / "open <URL>" / "clear"
- 本体 → 外枠（chrome_post）: "focus"（アドレス欄へ）か、状態を 1 行ずつ書いたもの（区切りはタブ文字）:
    state
    url  今の URL
    nav  戻れる 0/1  進める 0/1  読み込み中 0/1  ブックマーク済み 0/1
    tab  番号  今のタブなら 1  題
    bm   URL  題
    note 知らせ
-->
<meta charset="utf-8">
<style>
:root {{ color-scheme: light dark; --bg: #f3f3f3; --fg: #222; --tab: #e4e4e4; --cur: #fff; --line: #ccc; }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg: #202124; --fg: #e8e8e8; --tab: #2b2c2f; --cur: #35363a; --line: #444; }} }}
* {{ box-sizing: border-box; }}
body {{ margin: 0; font: 13px system-ui, sans-serif; background: var(--bg); color: var(--fg); overflow: hidden; user-select: none; }}
#tabs {{ display: flex; height: 28px; gap: 2px; padding: 2px 4px 0; }}
.tab {{ display: flex; align-items: center; max-width: 200px; min-width: 60px; flex: 1; padding: 0 6px; background: var(--tab); border-radius: 6px 6px 0 0; cursor: default; }}
.tab.cur {{ background: var(--cur); }}
.tab span {{ flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }}
.tab b {{ font-weight: normal; padding: 0 4px; opacity: .6; }}
.tab b:hover {{ opacity: 1; }}
#bar {{ display: flex; gap: 4px; padding: 3px 4px; background: var(--cur); height: 30px; }}
button {{ background: none; border: 0; color: inherit; font: inherit; width: 26px; border-radius: 4px; }}
button:hover:not(:disabled) {{ background: var(--tab); }}
button:disabled {{ opacity: .35; }}
#addr {{ flex: 1; border: 1px solid var(--line); border-radius: 12px; padding: 0 10px; background: var(--bg); color: inherit; font: inherit; }}
#bms {{ display: flex; gap: 8px; padding: 0 6px; height: 18px; background: var(--cur); border-bottom: 1px solid var(--line); overflow: hidden; white-space: nowrap; font-size: 12px; }}
#bms a {{ color: inherit; text-decoration: none; opacity: .8; }}
#note {{ margin-left: auto; opacity: .7; }}
</style>
<div id="tabs"></div>
<div id="bar">
  <button id="back" title="戻る (Alt+←)">←</button>
  <button id="fwd" title="進む (Alt+→)">→</button>
  <button id="rel" title="再読み込み (F5)">↻</button>
  <input id="addr" spellcheck="false" placeholder="URL か検索語">
  <button id="star" title="ブックマーク">☆</button>
  <button id="add" title="新しいタブ (Ctrl+T)">＋</button>
</div>
<div id="bms"></div>
<script>
const send = (s) => chrome.webview.postMessage(s);
const $ = (id) => document.getElementById(id);
let loading = false, editing = false;
$("back").onclick = () => send("back");
$("fwd").onclick = () => send("forward");
$("rel").onclick = () => send(loading ? "stop" : "reload");
$("star").onclick = () => send("bookmark");
$("add").onclick = () => send("newtab");
$("addr").onfocus = () => {{ editing = true; $("addr").select(); }};
$("addr").onblur = () => {{ editing = false; }};
$("addr").onkeydown = (e) => {{
  if (e.key === "Enter") {{ send("go " + $("addr").value); $("addr").blur(); }}
  if (e.key === "Escape") {{ $("addr").blur(); }}
}};
function el(tag, cls, text) {{ const x = document.createElement(tag); if (cls) x.className = cls; if (text !== undefined) x.textContent = text; return x; }}
chrome.webview.addEventListener("message", (ev) => {{
  const lines = String(ev.data).split("\\n");
  if (lines[0] === "focus") {{ $("addr").focus(); return; }}
  if (lines[0] !== "state") return;
  const tabs = $("tabs"), bms = $("bms");
  tabs.textContent = ""; bms.textContent = "";
  let note = "";
  for (const line of lines.slice(1)) {{
    const f = line.split("\\t");
    if (f[0] === "url" && !editing) $("addr").value = f[1];
    if (f[0] === "nav") {{
      $("back").disabled = f[1] !== "1"; $("fwd").disabled = f[2] !== "1";
      loading = f[3] === "1"; $("rel").textContent = loading ? "×" : "↻";
      $("star").textContent = f[4] === "1" ? "★" : "☆";
    }}
    if (f[0] === "tab") {{
      const t = el("div", f[2] === "1" ? "tab cur" : "tab");
      const name = el("span", "", f[3] || "新しいタブ"); name.title = f[3];
      const x = el("b", "", "×");
      t.onclick = () => send("select " + f[1]);
      x.onclick = (e) => {{ e.stopPropagation(); send("close " + f[1]); }};
      t.append(name, x); tabs.append(t);
    }}
    if (f[0] === "bm") {{
      const a = el("a", "", f[2] || f[1]); a.href = "#"; a.title = f[1];
      a.onclick = (e) => {{ e.preventDefault(); send("open " + f[1]); }};
      bms.append(a);
    }}
    if (f[0] === "note") note = f[1];
  }}
  if (note) {{ const n = el("span", "", note); n.id = "note"; bms.append(n); }}
}});
</script>
"""
}
