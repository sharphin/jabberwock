// エンジンとの境目（browser/engine/jw_engine.h と同じ形）を jabberwock から使うためのモジュール。
//
// 今はまだ jabberwock から C の関数を呼べないので、2 通りの動きを持つ:
// - パイプ（ふつう）: エンジンを動かす別の実行ファイル（browser/host/jwbrowser.c）が、このプログラムを
//   子プロセスとして起動する。操作は 1 行ずつ標準出力へ書き、イベントは標準入力から 1 行ずつ読む。
//   行の形は browser/host/README.md（区切りはタブ文字。文字の中の \ タブ 改行は \\ \t \n）。
// - 偽エンジン（Config.fake が true。テスト用）: browser/engine/mock/jwe_mock.c と同じ動き。
// std.browser ができたら、このファイルだけを std.browser を呼ぶものに置き換える。pub の型と関数の形は変えない。
//
// 偽エンジン: ページは読まず、決まった順にイベントを出す:
//   navigate → NavStarted → UrlChanged → TitleChanged（"title:" + URL）→ NavFinished → HistoryChanged
// 利用者の操作は Config.fake_script の行から作る（イベントが空のときに wait が 1 行ずつ出す）:
//   chrome <文字列> / key <番号> / newtab <URL> / close
// 台本が終わったら CloseRequested を 1 回出す。呼ばれた操作は log に残す（テストで見る）。

pub struct Config {
    str title;
    str data_dir;     // Cookie などの置き場所（1 か所だけ）
    i64 width;
    i64 height;
    bool ephemeral;   // true なら何も残さない
    bool fake;        // true なら偽エンジン（テスト用）
    str[] fake_script; // 偽エンジンだけが使う
}

pub enum Event {
    Ready;
    CloseRequested;
    NavStarted(i64 tab, str url);
    NavFinished(i64 tab, str url, i64 code);   // code 0 は成功
    UrlChanged(i64 tab, str url);
    TitleChanged(i64 tab, str title);
    HistoryChanged(i64 tab, bool back, bool forward);
    NewTabRequested(i64 tab, str url);
    ChromeMessage(str text);
    Key(i64 code);
    PermissionDenied(i64 tab, str what);
    Failed(i64 code, str text);
}

// キーの番号（jw_engine.h の JWE_KEY_*）
pub enum KeyCode {
    FocusAddress;
    NewTab;
    CloseTab;
    NextTab;
    PrevTab;
    Reload;
    Back;
    Forward;
    Unknown;

    static fn KeyCode of(i64 n) {
        match n {
            case 1 -> KeyCode.FocusAddress;
            case 2 -> KeyCode.NewTab;
            case 3 -> KeyCode.CloseTab;
            case 4 -> KeyCode.NextTab;
            case 5 -> KeyCode.PrevTab;
            case 6 -> KeyCode.Reload;
            case 7 -> KeyCode.Back;
            case 8 -> KeyCode.Forward;
            default -> KeyCode.Unknown;
        }
    }
}

pub struct Info {
    str name;
    bool script;      // ページの JavaScript が動く
    bool chrome_view; // 外枠を HTML で出せる
    bool persist;     // Cookie などを残せる
    bool frameless;   // OS のタイトルバーがなく、外枠が窓の一番上まで来る（外枠が ー □ × を出す）
}

// 窓の操作（jw_engine.h の JWE_WINDOW_*）
pub enum WindowOp {
    Drag;
    Minimize;
    ToggleMaximize;

    fn i64 code() {
        match this {
            case Drag -> 1;
            case Minimize -> 2;
            case ToggleMaximize -> 3;
        }
    }
}

struct FakeTab {
    i64 id;
    bool open;
    str[] hist;
    i64 pos;
}

pub struct Engine {
    bool piped;
    str name;         // エンジンの名前（パイプなら最初の info 行で知る）
    i64 caps;         // jw_engine.h の JWE_CAP_* の和
    i64 next_id;
    FakeTab[] tabs;
    Event[] queue;
    str[] script;
    i64 script_pos;
    bool close_sent;
    bool chrome;
    bool ephemeral;
    str[] log;          // 呼ばれた操作（偽エンジンだけ）

    static fn Engine open(Config cfg) {
        let mut e = Engine {
            piped: !cfg.fake, name: "mock", caps: 2, next_id: 1, tabs: [], queue: [], script: cfg.fake_script.map((l) -> l), script_pos: 0,
            close_sent: false, chrome: false, ephemeral: cfg.ephemeral, log: [],
        };
        e.log.push("open " + cfg.title);
        if e.piped {
            // 最初の行は「info 名前 caps」
            match read_line() {
                case Some(line) -> {
                    let f = line.split("\t");
                    if f.len() >= 3 && f[0] == "info" {
                        e.name = f[1];
                        e.caps = f[2].to_int().unwrap_or(0);
                    } else {
                        e.queue.push(parse(line));
                    }
                }
                case None -> e.queue.push(Event.CloseRequested);
            }
            e.send("set_title\t" + escape(cfg.title));   // Ready はエンジンから届く
        } else {
            e.queue.push(Event.Ready);
        }
        e
    }

    // ---- パイプ ----

    static fn str escape(str s) {
        s.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "")
    }

    static fn str unescape(str s) {
        if !s.contains("\\") {
            return s;
        }
        let mut out = "";
        let mut esc = false;
        for c in s.chars() {
            if esc {
                out += match c { case "t" -> "\t"; case "n" -> "\n"; default -> c; };
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else {
                out += c;
            }
        }
        out
    }

    fn send(str line) {
        print(line);
    }

    // エンジンから届いた 1 行をイベントにする
    static fn Event parse(str line) {
        let f = line.split("\t");
        let n = f.len();
        let kind = f[0];
        let a = if n > 1 { unescape(f[1]) } else { "" };
        let b = if n > 2 { unescape(f[2]) } else { "" };
        let c = if n > 3 { unescape(f[3]) } else { "" };
        let ai = a.to_int().unwrap_or(0);
        let bi = b.to_int().unwrap_or(0);
        match kind {
            case "ready" -> Event.Ready;
            case "close" -> Event.CloseRequested;
            case "nav_started" -> Event.NavStarted(ai, b);
            case "nav_finished" -> Event.NavFinished(ai, c, bi);
            case "url" -> Event.UrlChanged(ai, b);
            case "title" -> Event.TitleChanged(ai, b);
            case "history" -> Event.HistoryChanged(ai, (bi & 1) != 0, (bi & 2) != 0);
            case "new_tab" -> Event.NewTabRequested(ai, b);
            case "chrome" -> Event.ChromeMessage(a);
            case "key" -> Event.Key(ai);
            case "permission" -> Event.PermissionDenied(ai, b);
            case "error" -> Event.Failed(ai, b);
            default -> Event.Failed(3, "読めない行: " + line);
        }
    }

    fn Info info() {
        Info {
            name: name, script: (caps & 1) != 0, chrome_view: (caps & 2) != 0,
            persist: (caps & 4) != 0, frameless: (caps & 8) != 0,
        }
    }

    fn mut close() {
        log.push("close");
        if piped {
            send("close");
            read_line();   // 出した行を送り切る（read_line の前に出力がまとめて書き出される）。エンジンは返事をせずに閉じる
        }
    }

    // イベントがあれば取り出す（待たない）
    fn mut Option<Event> poll() {
        if queue.len() == 0 {
            return None;
        }
        Some(queue.remove(0))
    }

    // イベントが来るか timeout_ms たつまで待つ（-1 は無期限）
    fn mut Option<Event> wait(i64 timeout_ms) {
        if piped {
            if queue.len() == 0 {
                send("wait");   // 次のイベントを待ち始めた（偽エンジンにつないだとき、順番をそろえるのに使う）
                match read_line() {
                    case Some(line) -> queue.push(parse(line));
                    case None -> {
                        // エンジンがいなくなった
                        if !close_sent {
                            close_sent = true;
                            queue.push(Event.CloseRequested);
                        }
                    }
                }
            }
            return poll();
        }
        if queue.len() == 0 && !script_step() && !close_sent {
            close_sent = true;
            queue.push(Event.CloseRequested);
        }
        poll()
    }

    fn mut bool script_step() {
        while script_pos < script.len() {
            let line = script[script_pos];
            script_pos++;
            if line.trim() == "" || line.starts_with("#") {
                continue;
            }
            if line.starts_with("chrome ") {
                queue.push(Event.ChromeMessage(line.slice(7, line.len())));
            } else if line.starts_with("key ") {
                queue.push(Event.Key(line.slice(4, line.len()).to_int().unwrap_or(0)));
            } else if line.starts_with("newtab ") {
                queue.push(Event.NewTabRequested(shown_tab(), line.slice(7, line.len())));
            } else if line == "close" {
                queue.push(Event.CloseRequested);
            } else {
                queue.push(Event.Failed(3, "台本の行が読めません: " + line));
            }
            return true;
        }
        false
    }

    // 最後に見せたタブ（log から探す）
    fn i64 shown_tab() {
        let mut shown = 0;
        for l in log {
            if l.starts_with("tab_show ") {
                shown = l.slice(9, l.len()).to_int().unwrap_or(0);
            }
        }
        shown
    }

    fn i64 index_of(i64 tab) {
        for (i, t) in tabs {
            if t.id == tab && t.open {
                return i;
            }
        }
        -1
    }

    fn mut i64 tab_new() {
        let id = next_id;
        next_id++;
        if piped {
            send("tab_new\t{id}");
            tabs.push(FakeTab { id: id, open: true, hist: [], pos: 0 });
            return id;
        }
        tabs.push(FakeTab { id: id, open: true, hist: [], pos: 0 });
        log.push("tab_new {id}");
        id
    }

    fn mut Result<(), str> tab_close(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            let i = index_of(tab);
            tabs[i].open = false;
            send("tab_close\t{tab}");
            return Ok(());
        }
        let i = index_of(tab);
        if i < 0 {
            return Err("そのタブはありません");
        }
        tabs[i].open = false;
        tabs[i].hist = [];
        log.push("tab_close {tab}");
        Ok(())
    }

    fn mut Result<(), str> tab_show(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("tab_show\t{tab}");
            return Ok(());
        }
        if index_of(tab) < 0 {
            return Err("そのタブはありません");
        }
        log.push("tab_show {tab}");
        Ok(())
    }

    fn mut Result<(), str> navigate(i64 tab, str url) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("navigate\t{tab}\t" + escape(url));
            return Ok(());
        }
        let i = index_of(tab);
        if i < 0 {
            return Err("そのタブはありません");
        }
        if url == "" {
            return Err("URL が空です");
        }
        log.push("navigate {tab} {url}");
        // 今より先の履歴は捨てる
        while tabs[i].hist.len() > tabs[i].pos + 1 {
            tabs[i].hist.pop();
        }
        tabs[i].hist.push(url);
        tabs[i].pos = tabs[i].hist.len() - 1;
        load(i);
        Ok(())
    }

    fn mut Result<(), str> back(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("back\t{tab}");
            return Ok(());
        }
        let i = index_of(tab);
        if i < 0 {
            return Err("そのタブはありません");
        }
        log.push("back {tab}");
        if tabs[i].pos > 0 {
            tabs[i].pos = tabs[i].pos - 1;
            load(i);
        }
        Ok(())
    }

    fn mut Result<(), str> forward(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("forward\t{tab}");
            return Ok(());
        }
        let i = index_of(tab);
        if i < 0 {
            return Err("そのタブはありません");
        }
        log.push("forward {tab}");
        if tabs[i].pos + 1 < tabs[i].hist.len() {
            tabs[i].pos = tabs[i].pos + 1;
            load(i);
        }
        Ok(())
    }

    fn mut Result<(), str> reload(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("reload\t{tab}");
            return Ok(());
        }
        let i = index_of(tab);
        if i < 0 {
            return Err("そのタブはありません");
        }
        log.push("reload {tab}");
        if tabs[i].hist.len() > 0 {
            load(i);
        }
        Ok(())
    }

    fn mut Result<(), str> stop(i64 tab) {
        if piped {
            if index_of(tab) < 0 {
                return Err("そのタブはありません");
            }
            send("stop\t{tab}");
            return Ok(());
        }
        if index_of(tab) < 0 {
            return Err("そのタブはありません");
        }
        log.push("stop {tab}");
        Ok(())
    }

    fn mut load(i64 i) {
        let id = tabs[i].id;
        let url = tabs[i].hist[tabs[i].pos];
        queue.push(Event.NavStarted(id, url));
        queue.push(Event.UrlChanged(id, url));
        queue.push(Event.TitleChanged(id, "title:" + url));
        // "fail:" で始まる URL は読み込みに失敗したことにする
        queue.push(Event.NavFinished(id, url, if url.starts_with("fail:") { 1 } else { 0 }));
        queue.push(Event.HistoryChanged(id, tabs[i].pos > 0, tabs[i].pos + 1 < tabs[i].hist.len()));
    }

    fn mut Result<(), str> chrome_load(str html, i64 height) {
        if piped {
            chrome = true;
            send("chrome_load\t{height}\t" + escape(html));
            return Ok(());
        }
        log.push("chrome_load {height}");
        chrome = true;
        Ok(())
    }

    fn mut Result<(), str> chrome_post(str msg) {
        if piped {
            send("chrome_post\t" + escape(msg));
            return Ok(());
        }
        if !chrome {
            return Err("外枠がまだありません");
        }
        log.push("chrome_post " + msg);
        Ok(())
    }

    // 外枠の高さを変える。負なら外枠が窓全体を覆い、タブのページは隠れる（jw_engine.h の JWE_CHROME_FULL）
    fn mut Result<(), str> chrome_height(i64 height) {
        let h = if height < 0 { "full" } else { "{height}" };
        if piped {
            send("chrome_height\t" + h);
            return Ok(());
        }
        if !chrome {
            return Err("外枠がまだありません");
        }
        log.push("chrome_height " + h);
        Ok(())
    }

    fn mut Result<(), str> set_title(str title) {
        if piped {
            send("set_title\t" + escape(title));
            return Ok(());
        }
        log.push("set_title " + title);
        Ok(())
    }

    fn mut Result<(), str> window(WindowOp op) {
        let n = op.code();
        log.push("window {n}");
        if piped {
            send("window\t{n}");
        }
        Ok(())
    }

    fn mut Result<(), str> clear_site_data() {
        if piped {
            send("clear_site_data");
            return Ok(());
        }
        log.push("clear_site_data");
        Ok(())
    }
}
