// 履歴とブックマークをファイルに残す。1 行 1 件、「URL<タブ>題」のテキスト。
// 履歴だけは 3 つめの欄に見た時刻（unix のミリ秒）を書く。時刻のない前の形の行もそのまま読める（時刻は 0）。
// アカウントも同期もないので、置き場所はこのフォルダ 1 か所だけ。

use std.time;

const HISTORY_MAX = 1000;

pub struct Entry {
    str url;
    str title;
    i64 at;   // 見た時刻（unix のミリ秒。0 はわからない）。履歴だけで使う
}

pub struct Store {
    str dir;          // 空なら何も残さない
    Entry[] history;  // 古い順
    Entry[] bookmarks;
    Entry[] session;  // 前回閉じたときに開いていたタブ（設定で「前回開いていたタブ」のときだけ書く）
    str[] errors;     // 書けなかったときの説明（同じものは 1 回だけ）
    i64 clock;        // 0 なら本当の時計。0 でなければ試験用の決まった時計（呼ぶたびに 1 分進む）

    static fn Store open(str dir) { open_at(dir, 0) }

    // clock: 試験用の決まった時計の始まり（0 なら本当の時計）
    static fn Store open_at(str dir, i64 clock) {
        let mut s = Store { dir: dir, history: [], bookmarks: [], session: [], errors: [], clock: clock };
        if dir != "" {
            s.history = load(path(dir, "history.tsv"));
            s.bookmarks = load(path(dir, "bookmarks.tsv"));
            s.session = load(path(dir, "session.tsv"));
        }
        s
    }

    static fn str path(str dir, str name) {
        if dir.ends_with("/") || dir.ends_with("\\") { dir + name } else { dir + "/" + name }
    }

    static fn Entry[] load(str file) {
        let Entry[] mut out = [];
        match read_file(file) {
            case Ok(text) -> {
                for line in text.lines() {
                    if line == "" {
                        continue;
                    }
                    let f = line.split("\t");
                    let title = if f.len() > 1 { f[1] } else { "" };
                    let at = if f.len() > 2 { f[2].to_int().unwrap_or(0) } else { 0 };
                    out.push(Entry { url: f[0], title: title, at: at });
                }
            }
            case Err(_) -> {}   // まだないなら空
        }
        out
    }

    fn mut save(str name, str text) {
        if dir == "" {
            return;
        }
        match write_file(path(dir, name), text) {
            case Ok(_) -> {}
            case Err(e) -> {
                let msg = name + " を書けません: " + e;
                for x in errors {
                    if x == msg {
                        return;
                    }
                }
                errors.push(msg);
            }
        }
    }

    static fn str clean(str s) {
        s.replace("\t", " ").replace("\r", " ").replace("\n", " ")
    }

    static fn str to_text(ref Entry[] es) {
        let mut out = "";
        for e in es {
            out += clean(e.url) + "\t" + clean(e.title) + "\n";
        }
        out
    }

    // 履歴の形（3 つめの欄に時刻）
    static fn str to_history_text(ref Entry[] es) {
        let mut out = "";
        for e in es {
            out += clean(e.url) + "\t" + clean(e.title) + "\t{e.at}\n";
        }
        out
    }

    // 今の時刻（unix のミリ秒）
    fn mut i64 now() {
        if clock == 0 {
            return time.unix_ms();
        }
        let t = clock;
        clock += 60000;
        t
    }

    // 開いたページを足す。直前と同じ URL なら題だけ直す
    fn mut visit(str url, str title) {
        if url == "" || url.starts_with("data:") || url.starts_with("about:") {
            return;
        }
        let n = history.len();
        let at = now();
        if n > 0 && history[n - 1].url == url {
            if title != "" {
                history[n - 1].title = title;
            }
            history[n - 1].at = at;
        } else {
            history.push(Entry { url: url, title: title, at: at });
            while history.len() > HISTORY_MAX {
                history.remove(0);
            }
        }
        let text = to_history_text(history);
        save("history.tsv", text);
    }

    // いちばん新しい履歴の題を直す（題が読み込みのあとに届くことがあるため）
    fn mut retitle(str url, str title) {
        let n = history.len();
        if n > 0 && history[n - 1].url == url && history[n - 1].title != title {
            history[n - 1].title = title;
            let text = to_history_text(history);
            save("history.tsv", text);
        }
    }

    fn bool is_bookmarked(str url) {
        for b in bookmarks {
            if b.url == url {
                return true;
            }
        }
        false
    }

    // ブックマークを足すか外す。足したら true
    fn mut bool toggle_bookmark(str url, str title) {
        if url == "" {
            return false;
        }
        let mut added = true;
        for i in range(bookmarks.len()) {
            if bookmarks[i].url == url {
                bookmarks.remove(i);
                added = false;
                break;
            }
        }
        if added {
            bookmarks.push(Entry { url: url, title: title, at: 0 });
        }
        let text = to_text(bookmarks);
        save("bookmarks.tsv", text);
        added
    }

    // ブックマークを外す。外したら true
    fn mut bool remove_bookmark(str url) {
        for i in range(bookmarks.len()) {
            if bookmarks[i].url == url {
                bookmarks.remove(i);
                let text = to_text(bookmarks);
                save("bookmarks.tsv", text);
                return true;
            }
        }
        false
    }

    // 開いているタブを覚える（次の起動で開き直す）
    fn mut save_session(ref Entry[] tabs) {
        let text = to_text(tabs);
        save("session.tsv", text);
    }

    // 履歴から 1 件消す（時刻と URL の両方が合うもの）。消したら true
    fn mut bool forget(i64 at, str url) {
        for i in range(history.len()) {
            if history[i].at == at && history[i].url == url {
                history.remove(i);
                let text = to_history_text(history);
                save("history.tsv", text);
                return true;
            }
        }
        false
    }

    fn mut clear_history() {
        history = [];
        save("history.tsv", "");
    }
}
