// ブラウザ本体: タブ・アドレス欄・戻る/進む・履歴・ブックマーク。
// エンジンとは std.browser（runtime/engine/jw_engine.h の境目）だけで話す。エンジンの実装はビルドのときに --link で渡す。

use std.browser;
use address;
use store;
use chrome;
use settings;
use vault_link;

const HOME = "about:blank";
const SETTINGS_URL = "jw://settings";
const SETTINGS_ID = -1;   // 設定のタブの番号（エンジンのタブではない。外枠が窓全体を覆って画面を出す）

pub struct Tab {
    i64 id;
    str url;
    str title;
    bool loading;
    bool back;
    bool forward;
    bool settings;   // 設定のタブ
}

pub struct Browser {
    browser.Engine eng;
    store.Store data;
    settings.Settings prefs;
    Tab[] tabs;
    i64 current;     // 今のタブの番号（0 はなし）
    bool done;
    str note;        // 外枠に出す短い知らせ
    bool chrome_view;
    bool frameless;
    bool covered;    // 外枠が窓全体を覆っている（設定のタブを見せている）
    vault_link.Link vault;   // パスワードの金庫（別のプログラム）とのやりとり

    // data: 置き場所。ephemeral なら何も残さない（設定は読むだけ）。エンジンを開けなければ Err
    static fn Result<Browser, str> open(str data, bool ephemeral) {
        let data_dir = if ephemeral { "" } else { data };
        let prefs = settings.Settings.open(data, data_dir);
        let cfg = browser.Config { title: "jabberwock", data_dir: data, width: 1100, height: 760, ephemeral: ephemeral };
        let eng = browser.open(cfg)?;
        let chrome_view = eng.info().chrome_view;
        let frameless = eng.info().frameless;
        let mut b = Browser {
            eng: eng, data: store.Store.open(data_dir), prefs: prefs,
            tabs: [], current: 0, done: false, note: "", chrome_view: chrome_view, frameless: frameless, covered: false,
            vault: vault_link.Link.new(data),   // 金庫は --ephemeral でも同じ置き場所の vault.dat を使う
        };
        if chrome_view {
            let h = b.bar_height();
            b.check(b.eng.chrome_load(chrome.html(), h));
        }
        Ok(b)
    }

    // エンジンの操作が失敗したら知らせに出す（止めない）
    fn mut check(Result<(), str> r) {
        match r {
            case Ok(_) -> {}
            case Err(e) -> note = e;
        }
    }

    // 外枠の高さ（ブックマークバーを出すかで変わる）
    fn i64 bar_height() {
        chrome.height(prefs.on("bookmarks_bar"))
    }

    // 今のタブがページなら番号、設定のタブかタブがないなら 0
    fn i64 page() {
        let i = index_of(current);
        if i < 0 || tabs[i].settings { 0 } else { current }
    }

    fn i64 index_of(i64 id) {
        for (i, t) in tabs {
            if t.id == id {
                return i;
            }
        }
        -1
    }

    // ---- 操作 ----

    fn mut i64 new_tab(str url) {
        let id = match eng.tab_new() {
            case Ok(n) -> n;
            case Err(e) -> {
                note = e;
                return 0;
            }
        };
        tabs.push(Tab { id: id, url: url, title: "", loading: false, back: false, forward: false, settings: false });
        select(id);
        check(eng.navigate(id, url));
        id
    }

    fn mut select(i64 id) {
        let i = index_of(id);
        if i < 0 {
            return;
        }
        current = id;
        if tabs[i].settings {
            if !covered {
                covered = true;
                check(eng.chrome_height(-1));
            }
        } else {
            if covered {
                covered = false;
                let h = bar_height();
                check(eng.chrome_height(h));
            }
            check(eng.tab_show(id));
        }
        update_title();
    }

    // 設定のタブを開く（もうあればそこへ移る）
    fn mut open_settings() {
        if index_of(SETTINGS_ID) < 0 {
            tabs.push(Tab { id: SETTINGS_ID, url: SETTINGS_URL, title: "設定", loading: false, back: false, forward: false, settings: true });
        }
        select(SETTINGS_ID);
    }

    // 起動したときのタブ（設定の「起動したときに開くページ」）
    fn mut start() {
        match prefs.get("startup") {
            case "home" -> {
                let u = address.from_input(prefs.get("home")).unwrap_or(HOME);
                new_tab(u);
            }
            case "last" -> {
                let urls = data.session.map((e) -> e.url);
                if urls.len() == 0 {
                    new_tab(HOME);
                } else {
                    for u in urls {
                        new_tab(u);
                    }
                    let first = tabs[0].id;
                    select(first);
                }
            }
            default -> new_tab(HOME);
        }
    }

    // 「前回開いていたタブ」のときだけ、終わるときに開いているページを覚える
    fn mut save_session() {
        if prefs.get("startup") != "last" {
            return;
        }
        let store.Entry[] mut es = [];
        for t in tabs {
            if !t.settings && t.url != HOME {
                es.push(store.Entry { url: t.url, title: t.title });
            }
        }
        data.save_session(es);
    }

    fn mut apply_setting(str arg) {
        let sp = arg.find(" ");
        let key = match sp { case Some(i) -> arg.slice(0, i); case None -> arg; };
        let value = match sp { case Some(i) -> arg.slice(i + 1, arg.len()); case None -> ""; };
        if !prefs.set(key, value) {
            return;
        }
        if key == "bookmarks_bar" && !covered {
            let h = bar_height();
            check(eng.chrome_height(h));
        }
    }

    // 設定の画面のボタン
    fn mut act(str key) {
        match key {
            case "clear_data" -> clear_data();
            default -> note = "知らない設定の操作: " + key;
        }
    }

    fn mut clear_data() {
        check(eng.clear_site_data());
        data.clear_history();
        note = "Cookie と履歴を消しました";
    }

    fn mut close_tab(i64 id) {
        let i = index_of(id);
        if i < 0 {
            return;
        }
        if !tabs[i].settings {
            check(eng.tab_close(id));
        }
        tabs.remove(i);
        if tabs.len() == 0 {
            // 最後のタブを閉じたら、空のタブを 1 つ残す
            current = 0;
            new_tab(HOME);
            return;
        }
        if current == id {
            let next = if i < tabs.len() { i } else { tabs.len() - 1 };
            select(tabs[next].id);
        }
    }

    fn mut step_tab(i64 d) {
        let i = index_of(current);
        if i < 0 || tabs.len() == 0 {
            return;
        }
        let n = tabs.len();
        select(tabs[(i + d + n) % n].id);
    }

    fn mut go(str input) {
        if input.trim() == SETTINGS_URL {
            open_settings();
            return;
        }
        let search = settings.search_prefix(prefs.get("search"));
        match address.from_input_with(input, search) {
            case Some(u) -> {
                let i = index_of(current);
                if i < 0 {
                    new_tab(u);
                } else if tabs[i].settings {
                    // 設定のタブの場所でページを開く
                    let id = match eng.tab_new() {
                        case Ok(n) -> n;
                        case Err(e) -> {
                            note = e;
                            return;
                        }
                    };
                    tabs[i] = Tab { id: id, url: u, title: "", loading: false, back: false, forward: false, settings: false };
                    select(id);
                    check(eng.navigate(id, u));
                } else {
                    check(eng.navigate(current, u));
                }
            }
            case None -> {}
        }
    }

    fn mut toggle_bookmark() {
        let i = index_of(page());
        if i < 0 {
            return;
        }
        let u = tabs[i].url;
        let t = tabs[i].title;
        if data.toggle_bookmark(u, t) {
            note = "ブックマークに足しました";
        } else {
            note = "ブックマークから外しました";
        }
    }

    // ---- エンジンからのイベント ----

    fn mut handle(browser.Event ev) {
        match ev {
            case Ready -> {
                if tabs.len() == 0 {
                    start();
                }
            }
            case CloseRequested -> done = true;
            case NavStarted(id, u) -> {
                let i = index_of(id);
                if i >= 0 {
                    tabs[i].loading = true;
                    tabs[i].url = u;
                }
            }
            case NavFinished(id, u, code) -> {
                let i = index_of(id);
                if i >= 0 {
                    tabs[i].loading = false;
                    if code == 0 {
                        let t = tabs[i].title;
                        data.visit(u, t);
                    } else if id == current {
                        note = "読み込めませんでした（{code}）";
                    }
                }
            }
            case UrlChanged(id, u) -> {
                let i = index_of(id);
                if i >= 0 {
                    tabs[i].url = u;
                }
            }
            case TitleChanged(id, t) -> {
                let i = index_of(id);
                if i >= 0 {
                    tabs[i].title = t;
                    let u = tabs[i].url;
                    data.retitle(u, t);
                    if id == current {
                        update_title();
                    }
                }
            }
            case HistoryChanged(id, b, f) -> {
                let i = index_of(id);
                if i >= 0 {
                    tabs[i].back = b;
                    tabs[i].forward = f;
                }
            }
            case NewTabRequested(_, u) -> new_tab(u);
            case ChromeMessage(m) -> command(m);
            case Key(k) -> key(browser.KeyCode.of(k));
            case PermissionDenied(_, what) -> note = "断りました: " + what;
            case Failed(_, text) -> note = text;
        }
    }

    fn mut key(browser.KeyCode k) {
        match k {
            case FocusAddress -> check(eng.chrome_post("focus"));
            case NewTab -> {
                new_tab(HOME);
                check(eng.chrome_post("focus"));
            }
            case CloseTab -> close_tab(current);
            case NextTab -> step_tab(1);
            case PrevTab -> step_tab(-1);
            case Reload -> nav("reload");
            case Back -> nav("back");
            case Forward -> nav("forward");
            case Unknown -> {}
        }
    }

    // 今のページの戻る・進む・再読み込み・止める（設定のタブでは何もしない）
    fn mut nav(str op) {
        let id = page();
        if id == 0 {
            return;
        }
        match op {
            case "back" -> check(eng.back(id));
            case "forward" -> check(eng.forward(id));
            case "reload" -> check(eng.reload(id));
            default -> check(eng.stop(id));
        }
    }

    // 外枠から来た命令
    fn mut command(str m) {
        let sp = m.find(" ");
        let name = match sp { case Some(i) -> m.slice(0, i); case None -> m; };
        let arg = match sp { case Some(i) -> m.slice(i + 1, m.len()); case None -> ""; };
        match name {
            case "go" -> go(arg);
            case "open" -> go(arg);
            case "back" -> nav(name);
            case "forward" -> nav(name);
            case "reload" -> nav(name);
            case "stop" -> nav(name);
            case "settings" -> open_settings();
            case "vault" -> {
                let u = shown_url();
                match vault.open(u) {
                    case Ok(_) -> {}
                    case Err(e) -> note = e;
                }
            }
            case "set" -> apply_setting(arg);
            case "act" -> act(arg);
            case "newtab" -> {
                new_tab(HOME);
                check(eng.chrome_post("focus"));
            }
            case "select" -> select(arg.to_int().unwrap_or(0));
            case "close" -> close_tab(arg.to_int().unwrap_or(0));
            case "bookmark" -> toggle_bookmark();
            case "window" -> match arg {
                case "drag" -> check(eng.window(1));
                case "min" -> check(eng.window(2));
                case "max" -> check(eng.window(3));
                case "close" -> done = true;
                default -> note = "知らない窓の操作: " + arg;
            };
            case "clear" -> clear_data();
            default -> note = "知らない命令: " + name;
        }
    }

    // ---- 表示 ----

    fn mut update_title() {
        let i = index_of(current);
        let t = if i >= 0 && tabs[i].title != "" { tabs[i].title + " - jabberwock" } else { "jabberwock" };
        check(eng.set_title(t));
    }

    static fn str clean(str s) {
        s.replace("\t", " ").replace("\n", " ").replace("\r", " ")
    }

    static fn str flag(bool b) {
        if b { "1" } else { "0" }
    }

    // 外枠に今の状態を送る
    fn mut sync_chrome() {
        if !chrome_view {
            return;
        }
        let mut s = "state";
        let i = index_of(current);
        if i >= 0 {
            let u = tabs[i].url;
            let marked = data.is_bookmarked(u);
            s += "\nurl\t" + clean(if u == HOME { "" } else { u });
            s += "\nnav\t" + flag(tabs[i].back) + "\t" + flag(tabs[i].forward) + "\t" + flag(tabs[i].loading) + "\t" + flag(marked);
        }
        for t in tabs {
            let title = if t.url == HOME { "" } else { clean(t.title) };   // 空なら外枠が「新しいタブ」と出す
            let u = if t.url == HOME { "" } else { clean(t.url) };          // アイコンを決める
            s += "\ntab\t{t.id}\t" + flag(t.id == current) + "\t" + title + "\t" + u;
        }
        if frameless {
            s += "\nframe\t1";
        }
        s += "\nbmbar\t" + flag(prefs.on("bookmarks_bar")) + "\nicons\t" + flag(prefs.on("icons"));
        if covered {
            s += "\npage\tsettings" + prefs.to_chrome();
        }
        for b in data.bookmarks {
            s += "\nbm\t" + clean(b.url) + "\t" + clean(b.title);
        }
        for e in data.errors {
            note = e;
        }
        for e in prefs.errors {
            note = e;
        }
        if note != "" {
            s += "\nnote\t" + clean(note);
            note = "";
        }
        check(eng.chrome_post(s));
    }

    // 見えているタブの URL（設定のタブなら空）
    fn str shown_url() {
        let i = index_of(current);
        if i < 0 || tabs[i].settings {
            return "";
        }
        tabs[i].url
    }

    // 金庫から届いた行を処理する
    fn mut from_vault() {
        for line in vault.poll() {
            let f = line.split("\t");
            match f[0] {
                case "ask_site" -> {
                    let u = shown_url();
                    vault.send("site\t" + vault_link.escape(u));
                }
                case "fill" -> {
                    if f.len() != 4 {
                        continue;
                    }
                    // 見えているタブのログイン欄に入れる。出どころが完全に同じかはエンジンが確かめる
                    let code = if shown_url() == "" {
                        2
                    } else {
                        match eng.fill_login(current, vault_link.unescape(f[1]), vault_link.unescape(f[2]), vault_link.unescape(f[3])) {
                            case Ok(_) -> {
                                eng.window(4).unwrap_or(());   // ブラウザを手前に出す
                                0
                            }
                            case Err(_) -> 3;
                        }
                    };
                    vault.send("filled\t{code}");
                }
                default -> {}
            }
        }
        let u = shown_url();
        vault.tell(u);
    }

    // イベントを待って処理する。窓が閉じられたら終わる。金庫が動いているあいだは、短く待って金庫からの行も見る
    fn mut run() {
        while !done {
            let wait_ms = if vault.running() { 50 } else { -1 };
            match eng.wait(wait_ms) {
                case Some(ev) -> {
                    handle(ev);
                    // まとめて届いたイベントは全部処理してから外枠を直す
                    loop {
                        match eng.poll() {
                            case Some(ev2) -> handle(ev2);
                            case None -> break;
                        }
                    }
                    sync_chrome();
                }
                case None -> {}
            }
            from_vault();
        }
        save_session();
    }
}
