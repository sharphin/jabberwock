// 金庫（vault_main.jw）が使うエンジンと、ブラウザとのやりとり。
// - ふつう: 窓は std.browser（Windows なら WebView2。ビルドのときに --link で渡す）。金庫はブラウザ（親）が子プロセスとして起こし、
//   標準入力・標準出力の 1 行ずつで話す（行の形は vault_link.jw の先頭）。クリップボードは std.clipboard、乱数は std.random。
// - Config.fake が true なら偽エンジン（テスト用。エンジンもブラウザもない）。利用者の操作は Config.fake_script の行から作る
//   （イベントが空のときに wait が 1 行ずつ出す）:
//     chrome <文字列> / close / site <URL>（ブラウザの今のページ）/ filled <番号>（入力の結果）/ lock（しばらく触らなかった）/
//     show（ブラウザのメニューで金庫が押された）/ browser_exit（ブラウザが終わった）
//   台本が終わったら CloseRequested を 1 回出す。呼ばれた操作は log に残す（テストで見る）。

use std.browser;
use std.clipboard;
use std.hash;
use std.io;
use std.random;
use std.time;

pub struct Config {
    str title;
    str data_dir;     // 金庫の窓の WebView2 の置き場所
    i64 width;
    i64 height;
    bool fake;        // true なら偽エンジン（テスト用）
    str[] fake_script; // 偽エンジンだけが使う
}

pub enum Event {
    Ready;
    CloseRequested;
    ChromeMessage(str text);
    Failed(i64 code, str text);
    Site(str url);        // ブラウザの見えているタブの URL
    Filled(i64 code);     // 入力の結果（0 は入れた。2 はタブがない、3 はサイトが違う、-1 はブラウザがない）
    Lock;                 // しばらく触らなかった
    Show;                 // ブラウザで「パスワードの金庫」が押された（窓を出す）
    BrowserGone;          // ブラウザが終わった
    Other;                // 金庫には関係のないイベント
}

// 窓の操作（jw_engine.h の JWE_WINDOW_*）
pub enum WindowOp {
    Drag;
    Minimize;
    Focus;   // 隠した・最小化した窓を出して手前に出す
    Hide;    // 窓を隠す（タスクバーからも消える）

    fn i64 code() {
        match this {
            case Drag -> 1;
            case Minimize -> 2;
            case Focus -> 4;
            case Hide -> 5;
        }
    }
}

// コピーしたパスワードを消すまで・金庫を何もしないで閉じるまで（ミリ秒）
fn i64 clip_ms() { 30000 }
fn i64 idle_ms() { 300000 }

pub struct Engine {
    browser.Engine[] real;  // ふつうのときのエンジン（偽エンジンなら空）
    Event[] queue;
    str[] script;
    i64 script_pos;
    bool close_sent;
    bool chrome;
    str[] log;          // 呼ばれた操作（偽エンジンだけ）
    i64 random_count;   // 偽エンジンの乱数の番号
    bool parent;        // ブラウザ（親）とつながっている
    i64 clip_seq;       // 置いたクリップボードの番号（-1 はなし）
    i64 clip_at;
    i64 last_use;       // 最後に金庫の画面を触った時刻（0 は閉じる知らせを出したあと）

    static fn Result<Engine, str> open(Config cfg) {
        let mut e = Engine {
            real: [], queue: [], script: cfg.fake_script.map((l) -> l), script_pos: 0, close_sent: false, chrome: false,
            log: [], random_count: 0, parent: !cfg.fake, clip_seq: -1, clip_at: 0, last_use: time.unix_ms(),
        };
        e.log.push("open " + cfg.title);
        if cfg.fake {
            e.queue.push(Event.Ready);
            return Ok(e);
        }
        let b = browser.open(browser.Config { title: cfg.title, data_dir: cfg.data_dir, width: cfg.width, height: cfg.height, ephemeral: false })?;
        e.real.push(b);
        Ok(e)
    }

    fn mut close() {
        log.push("close");
        if clip_seq >= 0 {
            clipboard.clear_if(clip_seq).unwrap_or(false);
        }
        real.pop();
    }

    // イベントがあれば取り出す（待たない）
    fn mut Option<Event> poll() {
        if queue.len() == 0 {
            return None;
        }
        Some(queue.remove(0))
    }

    // イベントが来るまで待つ
    fn mut Option<Event> wait() {
        if real.len() == 0 {
            if queue.len() == 0 && !script_step() && !close_sent {
                // 台本が終わったら、窓を閉じてブラウザも終わったことにする（隠れたまま待ち続けないように）
                close_sent = true;
                queue.push(Event.CloseRequested);
                queue.push(Event.BrowserGone);
            }
            return poll();
        }
        while queue.len() == 0 {
            match real[0].wait(50) {
                case Some(ev) -> {
                    let x = of(ev);
                    match x {
                        case ChromeMessage(_) -> last_use = time.unix_ms();
                        default -> {}
                    }
                    queue.push(x);
                }
                case None -> {}
            }
            from_parent();
            tick();
        }
        poll()
    }

    static fn Event of(browser.Event ev) {
        match ev {
            case Ready -> Event.Ready;
            case CloseRequested -> Event.CloseRequested;
            case ChromeMessage(m) -> Event.ChromeMessage(m);
            case Failed(c, t) -> Event.Failed(c, t);
            default -> Event.Other;
        }
    }

    // ブラウザから届いた行（待たない）
    fn mut from_parent() {
        if !parent {
            return;
        }
        loop {
            match io.read_line_for(0) {
                case Ok(Some(line)) -> parent_line(line);
                case Ok(None) -> {
                    parent = false;   // ブラウザが終わった（入力はできなくなる。金庫を閉じるかは vault_main が決める）
                    queue.push(Event.BrowserGone);
                    return;
                }
                case Err(_) -> return;   // まだ届いていない
            }
        }
    }

    fn mut parent_line(str line) {
        let f = line.split("\t");
        let a = if f.len() > 1 { unescape(f[1]) } else { "" };
        match f[0] {
            case "site" -> queue.push(Event.Site(a));
            case "filled" -> queue.push(Event.Filled(a.to_int().unwrap_or(-1)));
            case "show" -> queue.push(Event.Show);
            default -> {}
        }
    }

    // 時間で起きること: コピーしたパスワードを消す・しばらく触らなければ閉じる
    fn mut tick() {
        let now = time.unix_ms();
        if clip_seq >= 0 && now - clip_at >= clip_ms() {
            clipboard.clear_if(clip_seq).unwrap_or(false);
            clip_seq = -1;
        }
        if last_use > 0 && now - last_use >= idle_ms() {
            last_use = 0;
            queue.push(Event.Lock);
        }
    }

    fn mut bool script_step() {
        while script_pos < script.len() {
            let line = script[script_pos];
            script_pos++;
            if line.trim() == "" || line.starts_with("#") {
                continue;
            }
            if line.starts_with("chrome ") {
                queue.push(Event.ChromeMessage(line.slice(7, line.len())));
            } else if line == "close" {
                queue.push(Event.CloseRequested);
            } else if line.starts_with("site ") {
                queue.push(Event.Site(line.slice(5, line.len())));
            } else if line.starts_with("filled ") {
                queue.push(Event.Filled(line.slice(7, line.len()).to_int().unwrap_or(0)));
            } else if line == "lock" {
                queue.push(Event.Lock);
            } else if line == "show" {
                queue.push(Event.Show);
            } else if line == "browser_exit" {
                queue.push(Event.BrowserGone);
            } else {
                queue.push(Event.Failed(3, "台本の行が読めません: " + line));
            }
            return true;
        }
        false
    }

    fn mut Result<(), str> chrome_load(str html) {
        chrome = true;
        if real.len() > 0 {
            return real[0].chrome_load(html, 0);
        }
        log.push("chrome_load 0");
        Ok(())
    }

    fn mut Result<(), str> chrome_post(str msg) {
        if real.len() > 0 {
            return real[0].chrome_post(msg);
        }
        if !chrome {
            return Err("外枠がまだありません");
        }
        log.push("chrome_post " + msg);
        Ok(())
    }

    // 外枠が窓全体を覆う（金庫はページを開かない）
    fn mut Result<(), str> chrome_full() {
        if real.len() > 0 {
            return real[0].chrome_height(-1);
        }
        if !chrome {
            return Err("外枠がまだありません");
        }
        log.push("chrome_height full");
        Ok(())
    }

    fn mut Result<(), str> window(WindowOp op) {
        let n = op.code();
        if real.len() > 0 {
            return real[0].window(n);
        }
        log.push("window {n}");
        Ok(())
    }

    // OS の乱数を n バイト（偽エンジンは毎回同じ並び。テスト用）
    fn mut u8[] random(i64 n) {
        if real.len() > 0 {
            return random.bytes(n);
        }
        let u8[] mut out = [];
        while out.len() < n {
            let seed = "random {random_count}".bytes();
            let block = hash.sha256(ref seed);
            random_count++;
            for b in block {
                if out.len() < n {
                    out.push(b);
                }
            }
        }
        log.push("random {n}");
        out
    }

    // クリップボードに置く（30 秒たってだれも変えていなければ消す。クリップボードの履歴には残さない）
    fn mut Result<(), str> copy_text(str text, bool secret) {
        if real.len() == 0 {
            log.push("copy ({text.len()} 文字)");
            return Ok(());
        }
        let n = clipboard.set_text(text, secret)?;
        if secret {
            clip_seq = n;
            clip_at = time.unix_ms();
        }
        Ok(())
    }

    // ブラウザの見えているタブのログイン欄に入れるよう頼む。結果は Filled で届く
    fn mut fill(str site, str user, str password) {
        if real.len() == 0 {
            log.push("fill " + site + " " + user + " ({password.len()} 文字)");
            return;
        }
        if !parent {
            queue.push(Event.Filled(-1));
            return;
        }
        print("fill\t" + escape(site) + "\t" + escape(user) + "\t" + escape(password));   // 次の wait の前に書き出される
    }

    // ブラウザに今の URL を聞く。答えは Site で届く
    fn mut ask_site() {
        if real.len() == 0 {
            log.push("ask_site");
            return;
        }
        if parent {
            print("ask_site");
        }
    }
}

pub fn str escape(str s) {
    s.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "")
}

pub fn str unescape(str s) {
    if !s.contains("\\") {
        return s;
    }
    let mut out = "";
    let mut esc = false;
    for c in s.chars() {
        if esc {
            out += match c { case "t" -> "\t"; case "n" -> "\n"; default -> c; };
            esc = false;
        } else if c == "\\" {
            esc = true;
        } else {
            out += c;
        }
    }
    out
}
