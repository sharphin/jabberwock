// jabberwock の軽量ブラウザ。jwc でエンジンの実装とリンクして実行ファイルにする:
//   jwc build --link <エンジン> -o jabberwock-browser browser/app/main.jw
//   エンジンは Windows なら WebView2 版（browser/build-windows.sh）、試験なら runtime/engine/mock/jwe_mock.c
// 動かし方: jabberwock-browser [--data フォルダ] [--ephemeral]
// --data: 履歴・ブックマーク・設定・Cookie の置き場所（既定は Windows なら %LOCALAPPDATA%\jabberwock-browser、ほかは ./browser-data）
// --ephemeral: 何も残さない

use browser;
use std.env;
use std.fs;

// 置き場所の既定
fn str default_data() {
    match env.get("LOCALAPPDATA") {
        case Some(d) -> {
            if d != "" {
                return d + "\\jabberwock-browser";
            }
        }
        case None -> {}
    }
    "browser-data"
}

fn main() {
    let a = args();
    let mut data = "";
    let mut ephemeral = false;
    let mut i = 0;
    while i < a.len() {
        match a[i] {
            case "--data" -> {
                i++;
                if i < a.len() { data = a[i]; }
            }
            case "--ephemeral" -> ephemeral = true;
            default -> {
                eprint("知らない引数:", a[i]);
                exit(2);
            }
        }
        i++;
    }
    if data == "" {
        data = default_data();
    }
    if !ephemeral && !fs.exists(data) {
        match fs.make_dir(data) {
            case Ok(_) -> {}
            case Err(e) -> {
                eprint("置き場所を作れません:", data, e);
                exit(1);
            }
        }
    }
    let mut b = match browser.Browser.open(data, ephemeral) {
        case Ok(x) -> x;
        case Err(e) -> {
            eprint("エンジンを開けません:", e);
            exit(1)
        }
    };
    b.run();
}
