use chrome;
use vault_ui;
fn main() {
    let src = match read_file("chrome.html") { case Ok(t) -> t; case Err(e) -> { print(e); exit(1) } };
    assert(chrome.html() == src);
    let vsrc = match read_file("vault.html") { case Ok(t) -> t; case Err(e) -> { print(e); exit(1) } };
    assert(vault_ui.html() == vsrc);
    print("ok");
}
