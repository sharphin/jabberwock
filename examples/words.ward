// 単語の数え上げ（試しに書いたプログラム）。辞書がないので、リストを先頭から探す
struct Count {
    str word;
    i64 n;
}

fn Count[] count_words(ref str[] words) {
    let Count[] mut out = [];
    for w in words {
        let mut found = false;
        for i in range(out.len()) {
            if out[i].word == w {
                out[i].n += 1;
                found = true;
                break;
            }
        }
        if !found {
            out.push(Count { word: w, n: 1 });
        }
    }
    out
}

fn main() {
    let text = "the cat and the dog and the bird";
    let own str[] words = own ["the", "cat", "and", "the", "dog", "and", "the", "bird"];
    let counts = count_words(ref words);
    for i in range(counts.len()) {
        print("{counts[i].word}: {counts[i].n}");
    }
}
