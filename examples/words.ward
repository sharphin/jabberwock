// 単語の数え上げ（試しに書いたプログラム）。辞書がないので、リストを先頭から探す
// ファイル名のあとに文章を渡すと、それを数える（ward words.ward "a b a"）
struct Count {
    str word;
    i64 n;
}

fn Count[] count_words(ref str[] words) {
    let Count[] mut out = [];
    for w in words {
        let mut found = false;
        for i in range(out.len()) {
            if out[i].word == w {
                out[i].n += 1;
                found = true;
                break;
            }
        }
        if !found {
            out.push(Count { word: w, n: 1 });
        }
    }
    out
}

fn main() {
    let mut text = "the cat and the dog and the bird";
    let a = args();
    if a.len() > 0 {
        text = a[0];
    }
    let words = text.split(" ");
    let counts = count_words(words);
    for c in counts {
        print("{c.word}: {c.n}");
    }
}
